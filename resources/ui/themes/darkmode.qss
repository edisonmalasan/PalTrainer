/* GENERATED FILE — do not edit by hand.
   Global rules: src/palworld_aio/ui/chrome/qss_builder.py (edit there).
   Rebuild: uv run python scripts/scrs/build_theme.py */

/* ==== PalTrainer application stylesheet — generated by qss_builder. ====
   Do not edit the deployed .qss by hand; edit tokens/qss_builder and run
   scripts/scrs/build_theme.py. */

/* ---- canvas & default text ---- */
QWidget#central {
    background-color: #141312;
    color: #ECE7E0;
    font-family: 'Inter 28pt','Inter','Segoe UI';
}
QLabel {
    color: #ECE7E0;
    background: transparent;
}
QLabel[role="secondary"] { color: #A69F94; font-size: 12px; }
QLabel[role="muted"] { color: #5C564E; font-size: 12px; }
QLabel[role="accent"] { color: #F59E0B; font-size: 12px; }
QLabel[role="success"] { color: #2DD4BF; font-size: 12px; }
QLabel[role="warning"] { color: #E8B44C; font-size: 12px; }
QLabel[role="danger"] { color: #F87171; font-size: 12px; }
QLabel[role="mono"] { font-family: 'Cascadia Mono','Consolas'; }
/* uiux-audit-remediation 2.4 (design D5): mono token class for technical
   data on non-label widgets; the bundled Cascadia Mono family resolves the
   stack, Consolas is the system fallback. */
QPushButton[class="mono"], QToolButton[class="mono"], QLineEdit[class="mono"] {
    font-family: 'Cascadia Mono','Consolas';
}

QStackedWidget {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    color: #ECE7E0;
}
QStackedWidget > QWidget {
    background: transparent;
    color: #ECE7E0;
}
QScrollArea {
    border: none;
    background: transparent;
    border-radius: 10px;
}
/* Inner scroll containers must not fall back to the light default palette
   (Breeding results rendered as a white rectangle without this rule). */
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---- inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 5px 10px;
    selection-background-color: rgba(245,158,11,0.18);
    selection-color: #ECE7E0;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid rgba(245,158,11,0.5);
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(236,231,224,0.18);
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QLineEdit[error="true"], QSpinBox[error="true"], QDoubleSpinBox[error="true"] {
    border: 1px solid rgba(248,113,113,0.35);
    background-color: rgba(248,113,113,0.12);
}
QLineEdit[error="true"]:focus { border: 1px solid #F87171; }
/* uiux-audit-remediation 7.5 (Phase 3.3): compact jump-to-box selector in
   the Pal Editor mode bar — tighter than the default spin chrome. */
QSpinBox#boxJumpSpin {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 1px 2px;
    min-height: 0px;
}
QSpinBox#boxJumpSpin:focus { border: 1px solid rgba(245,158,11,0.5); }
QSpinBox#boxJumpSpin::up-button, QSpinBox#boxJumpSpin::down-button {
    background: #211E1B;
    border: none;
    width: 14px;
}
QSpinBox#boxJumpSpin::up-button:hover, QSpinBox#boxJumpSpin::down-button:hover {
    background: rgba(245,158,11,0.07);
}

QComboBox {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 18px;
}
QComboBox:hover { border-color: rgba(236,231,224,0.18); }
QComboBox:focus { border-color: rgba(245,158,11,0.5); }
QComboBox:disabled { background-color: #1B1917; color: #5C564E; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #A69F94;
    margin-right: 6px;
}
QComboBox::down-arrow:hover { border-top-color: #ECE7E0; }
QComboBox QAbstractItemView {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(245,158,11,0.18);
    selection-color: #ECE7E0;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 10px;
    border-radius: 6px;
    min-height: 24px;
}
QPushButton#styledComboButton {
    background: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 4px 8px;
    text-align: left;
}
QPushButton#styledComboButton:hover { border-color: rgba(236,231,224,0.18); }
QPushButton#styledComboButton:focus { border-color: rgba(245,158,11,0.5); }
QPushButton#styledComboButton:disabled { color: #5C564E; }
QPushButton#toggleCheckButton {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 0;
}
QPushButton#toggleCheckButton:checked {
    background: rgba(245,158,11,0.18);
    border-color: rgba(245,158,11,0.5);
}
QPushButton#toggleCheckButton:focus { border-color: #F7B03A; }
QFrame#styledComboPopup { background: transparent; }
QListWidget#styledComboList {
    background: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QListWidget#styledComboList::item {
    padding: 4px 10px;
    border-radius: 6px;
    min-height: 24px;
}
QListWidget#styledComboList::item:selected { background: rgba(245,158,11,0.18); color: #ECE7E0; }
QListWidget#styledComboList::item:hover { background: rgba(245,158,11,0.07); }
QListWidget#styledComboList::item:disabled { color: #5C564E; }
QSpinBox::up-button, QSpinBox::down-button {
    background: #211E1B;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: rgba(245,158,11,0.07); }
QSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #A69F94;
}
QSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #A69F94;
}

/* ---- buttons ---- */
QPushButton {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QPushButton:pressed {
    background-color: #262220;
}
QPushButton:focus {
    border: 2px solid #F7B03A;
}
QPushButton:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="primary"] {
    background-color: #F59E0B;
    color: #1C1206;
    border: 1px solid #F59E0B;
    padding: 6px 14px;
    min-height: 8px;
}
QPushButton[class="primary"]:hover {
    background-color: #F7B03A;
    border-color: #F7B03A;
}
QPushButton[class="primary"]:pressed { background-color: #D98A06; }
QPushButton[class="primary"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="primary"]:checked { background-color: #D98A06; }
QPushButton[class="primary"]:disabled {
    background-color: #211E1B;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="danger"] {
    background-color: rgba(248,113,113,0.12);
    color: #F87171;
    border: 1px solid rgba(248,113,113,0.35);
}
QPushButton[class="danger"]:hover {
    background-color: rgba(248,113,113,0.12);
    border-color: #F87171;
}
QPushButton[class="danger"]:pressed { background-color: rgba(248,113,113,0.35); }
QPushButton[class="danger"]:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="ghost"] {
    background: transparent;
    color: #A69F94;
    border: 1px solid transparent;
}
QPushButton[class="ghost"]:hover {
    background-color: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[class="ghost"]:pressed { background-color: rgba(245,158,11,0.12); }
QPushButton[class="ghost"]:disabled { color: #5C564E; background: transparent; }
QPushButton[class="tool"] {
    background: transparent;
    color: #A69F94;
    border: 1px solid transparent;
    padding: 4px;
}
QPushButton[class="tool"]:hover {
    background-color: rgba(245,158,11,0.07);
    color: #ECE7E0;
    border-radius: 8px;
}
QPushButton[class="tool"]:pressed { background-color: rgba(245,158,11,0.12); }
QPushButton[class="tool"]:checked {
    background-color: rgba(245,158,11,0.12);
    color: #F59E0B;
    border-color: rgba(245,158,11,0.3);
}
QPushButton[class="tool"]:disabled { color: #5C564E; }

/* ---- audit shared control hierarchy ---- */
QPushButton[class="secondary"] {
    background: #211E1B; color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
}
QPushButton[class="secondary"]:hover { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.3); }
QPushButton[class="secondary"]:pressed { background: #262220; }
QPushButton[class="secondary"]:checked { background: rgba(245,158,11,0.18); border-color: rgba(245,158,11,0.5); }
QPushButton[class="secondary"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="secondary"]:disabled { background: #1B1917; color: #5C564E; border-color: rgba(236,231,224,0.1); }

QPushButton[class="tertiary"] { background: transparent; color: #A69F94; border: 1px solid transparent; }
QPushButton[class="tertiary"]:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton[class="tertiary"]:pressed { background: rgba(245,158,11,0.12); }
QPushButton[class="tertiary"]:checked { background: rgba(245,158,11,0.1); color: #F59E0B; }
QPushButton[class="tertiary"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="tertiary"]:disabled { background: transparent; color: #5C564E; }

QPushButton[class="warning"] { background: rgba(232,180,76,0.12); color: #E8B44C; border: 1px solid rgba(232,180,76,0.35); }
QPushButton[class="warning"]:hover { background: rgba(245,158,11,0.07); border-color: #E8B44C; }
QPushButton[class="warning"]:pressed { background: rgba(232,180,76,0.35); }
QPushButton[class="warning"]:checked { background: rgba(232,180,76,0.35); color: #ECE7E0; }
QPushButton[class="warning"]:focus { border: 2px solid #E8B44C; }
QPushButton[class="warning"]:disabled { background: #1B1917; color: #5C564E; border-color: rgba(236,231,224,0.1); }

QPushButton[class="destructive"] { background: rgba(248,113,113,0.12); color: #F87171; border: 1px solid rgba(248,113,113,0.35); }
QPushButton[class="destructive"]:hover { background: rgba(245,158,11,0.07); border-color: #F87171; }
QPushButton[class="destructive"]:pressed { background: rgba(248,113,113,0.35); }
QPushButton[class="destructive"]:checked { background: rgba(248,113,113,0.35); color: #ECE7E0; }
QPushButton[class="destructive"]:focus { border: 2px solid #F87171; }
QPushButton[class="destructive"]:disabled { background: #1B1917; color: #5C564E; border-color: rgba(236,231,224,0.1); }

QPushButton[class="icon"] { background: transparent; color: #A69F94; border: 1px solid transparent; padding: 4px; }
QPushButton[class="icon"]:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton[class="icon"]:pressed { background: rgba(245,158,11,0.12); }
QPushButton[class="icon"]:checked { background: rgba(245,158,11,0.18); border-color: rgba(245,158,11,0.3); }
QPushButton[class="icon"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="icon"]:disabled { background: transparent; color: #5C564E; }

QPushButton[class="segmented"] {
    background: #211E1B; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.18); border-radius: 0;
}
QPushButton[class="segmented"][segmentPosition="start"] { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QPushButton[class="segmented"][segmentPosition="end"] { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QPushButton[class="segmented"][segmentPosition="only"] { border-radius: 8px; }
QPushButton[class="segmented"]:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton[class="segmented"]:pressed { background: rgba(245,158,11,0.12); }
QPushButton[class="segmented"]:checked { background: rgba(245,158,11,0.18); color: #F59E0B; border-color: rgba(245,158,11,0.5); }
QPushButton[class="segmented"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="segmented"]:disabled { background: #1B1917; color: #5C564E; border-color: rgba(236,231,224,0.1); }

QPushButton[class="chip"], QPushButton[class="filter"], QPushButton[class="tab"] {
    background: #1B1917; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 9999px;
    padding: 4px 12px;
}
QPushButton[class="chip"]:hover, QPushButton[class="filter"]:hover, QPushButton[class="tab"]:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton[class="chip"]:pressed, QPushButton[class="filter"]:pressed, QPushButton[class="tab"]:pressed { background: rgba(245,158,11,0.12); }
QPushButton[class="chip"]:checked, QPushButton[class="filter"]:checked, QPushButton[class="tab"]:checked { background: rgba(245,158,11,0.18); color: #F59E0B; border-color: rgba(245,158,11,0.5); }
QPushButton[class="chip"][pickerSelected="true"] { background: rgba(245,158,11,0.1); color: #F59E0B; border-color: rgba(245,158,11,0.5); }
QPushButton[class="chip"]:focus, QPushButton[class="filter"]:focus, QPushButton[class="tab"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="chip"]:disabled, QPushButton[class="filter"]:disabled, QPushButton[class="tab"]:disabled { background: #1B1917; color: #5C564E; border-color: rgba(236,231,224,0.1); }

/* ---- selection views ---- */
QPushButton[class="palTrait"] { background: transparent; border: 1px solid rgba(236,231,224,0.1); border-radius: 6px; padding: 0; }
QPushButton[class="palTrait"]:hover { background: rgba(245,158,11,0.07); }
QPushButton[class="palTrait"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="palTrait"]:disabled { background: transparent; border-color: rgba(236,231,224,0.1); color: #5C564E; }
QPushButton[class="palTrait"][traitRole="danger"]:checked { background: rgba(248,113,113,0.12); border-color: #F87171; color: #F87171; }
QPushButton[class="palTrait"][traitRole="warning"]:checked { background: rgba(232,180,76,0.12); border-color: #E8B44C; color: #E8B44C; }
QPushButton[class="palTrait"][traitRole="special"]:checked { background: rgba(192,132,252,0.12); border-color: #C084FC; color: #C084FC; }
QPushButton[class="palTrait"][traitRole="info"]:checked { background: rgba(147,183,221,0.1); border-color: #93B7DD; color: #93B7DD; }
QPushButton[class="palTrait"][traitRole="success"] { color: #2DD4BF; }
QPushButton[class="palTrait"][traitRole="warning"] { color: #E8B44C; }
QPushButton[class="palMini"] { background: rgba(147,183,221,0.1); color: #93B7DD; border: 1px solid rgba(147,183,221,0.3); border-radius: 6px; padding: 0; }
QPushButton[class="palMini"]:hover { background: rgba(147,183,221,0.3); }
QPushButton[class="palMini"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="palMini"]:disabled { background: transparent; color: #5C564E; border-color: rgba(236,231,224,0.1); }
QPushButton[class="palMini"][traitRole="warning"] { background: rgba(232,180,76,0.12); color: #E8B44C; border-color: rgba(232,180,76,0.35); }
QPushButton[class="palMini"][traitRole="warning"]:hover { background: rgba(232,180,76,0.35); }
QPushButton[class="palOverlayButton"] { background: transparent; border: none; padding: 0; }
QPushButton[class="palOverlayButton"]:hover { background: transparent; }
QPushButton[class="palOverlayButton"]:focus { border: 2px solid #F7B03A; }
QPushButton[class="palCopy"] { background: transparent; color: #A69F94; border: none; padding: 0; }
QPushButton[class="palCopy"]:hover { color: #93B7DD; }
QPushButton[class="palCopy"]:focus { border: 2px solid #F7B03A; }
QLabel#boxHeader { color: #A69F94; font-size: 11px; }
QWidget#pickerPopup { background: #211E1B; border: 1px solid rgba(245,158,11,0.3); border-radius: 8px; }
QListWidget#pickerList { background: transparent; border: none; }
QListWidget#pickerList::item { padding: 3px 8px; }
QListWidget#pickerList::item:hover { background: rgba(245,158,11,0.07); }
QListWidget#pickerList::item:selected { background: rgba(245,158,11,0.18); color: #ECE7E0; }
QListWidget#dataList { background: #262220; border: 1px solid rgba(236,231,224,0.1); }
QTreeWidget#baseTree, QTreeWidget#playerTree { border: none; background: transparent; }
QTreeWidget#baseTree::item, QTreeWidget#playerTree::item { padding: 2px 4px; }
QScrollArea#subPopupScroll, QScrollArea#contextMenuScroll { background: transparent; border: none; border-radius: 0; }
QSplitter#collapsibleSplitter::handle:horizontal { background: rgba(236,231,224,0.1); width: 16px; }
QTreeWidget, QTreeView, QListWidget, QTableWidget, QTableView, QListView {
    background: transparent;
    color: #ECE7E0;
    border: 1px solid transparent;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #1B1917;
}
QTreeWidget:focus, QTreeView:focus, QListWidget:focus,
QTableWidget:focus, QTableView:focus, QListView:focus {
    border: 1px solid rgba(245,158,11,0.3);
}
QTreeWidget::item, QTreeView::item, QListWidget::item,
QListView::item, QTableWidget::item, QTableView::item {
    padding: 4px 8px;
    border-radius: 6px;
    color: #ECE7E0;
}
QTreeWidget::item:hover, QTreeView::item:hover, QListWidget::item:hover,
QListView::item:hover {
    background: rgba(245,158,11,0.07);
}
QTreeWidget::item:selected, QTreeView::item:selected, QListWidget::item:selected,
QListView::item:selected {
    background: rgba(245,158,11,0.18);
    color: #ECE7E0;
}
QTreeWidget::item:selected:!active, QTreeView::item:selected:!active,
QListWidget::item:selected:!active, QListView::item:selected:!active {
    background: rgba(245,158,11,0.1);
}
QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(245,158,11,0.18);
    color: #ECE7E0;
}
QHeaderView { background: transparent; border: none; }
QHeaderView::section {
    background-color: #1B1917;
    color: #A69F94;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    border-right: 1px solid rgba(236,231,224,0.1);
    height: 28px;
    font-size: 12px;
    font-weight: 600;
}
QHeaderView::section:hover { background-color: #211E1B; }
QHeaderView::section:last { border-right: none; }

/* ---- feedback & chrome ---- */
QProgressBar {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #A69F94;
    font-size: 11px;
}
QProgressBar::chunk {
    background: #F59E0B;
    border-radius: 5px;
}
QCheckBox, QRadioButton {
    color: #ECE7E0;
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(236,231,224,0.18);
    background: #262220;
}
QCheckBox::indicator { border-radius: 6px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: rgba(245,158,11,0.3);
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #F59E0B;
    border-color: #F59E0B;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #1B1917;
    border-color: rgba(236,231,224,0.1);
}
QGroupBox {
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    margin-top: 10px;
    color: #A69F94;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #A69F94;
}

/* ---- menus, tooltips, status ---- */
QMenu {
    background-color: rgba(27,25,23,0.98);
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
    padding: 4px;
    color: #ECE7E0;
    font-size: 14px;
}
QMenu::item {
    padding: 8px 12px;
    background: transparent;
    border-radius: 6px;
    color: #ECE7E0;
}
QMenu::item:selected { background: rgba(245,158,11,0.18); color: #ECE7E0; }
QMenu::item:disabled { color: #5C564E; }
QMenu::separator {
    height: 1px;
    background: rgba(236,231,224,0.1);
    margin: 4px 0;
}
QToolTip {
    background-color: rgba(33,30,27,0.98);
    color: #ECE7E0;
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
}
/* ---- shell v3 app bar (top-nav-shell 2.1) ---- */
QFrame#appBar {
    background: #1B1917;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QPushButton#brandMark {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 2px 4px;
}
QPushButton#brandMark:hover { background: rgba(245,158,11,0.07); }
QPushButton#brandMark[pulse="true"] { background: rgba(245,158,11,0.1); }
QLabel#brandWordmark {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px;
    font-weight: 600;
    background: transparent;
}
QPushButton#saveStateChip {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 3px 6px;
}
QPushButton#saveStateChip:hover { border-color: rgba(245,158,11,0.3); color: #ECE7E0; }
QPushButton#saveStateChip[state="loaded"], QPushButton#saveStateChip[state="dirty"] { color: #ECE7E0; }
QPushButton#saveStateChip[state="dirty"] { border-color: rgba(232,180,76,0.35); }
QPushButton#saveStateChip[state="error"] { border-color: rgba(248,113,113,0.35); }
QPushButton#saveStateChip[pulse="true"] { border-color: #F59E0B; color: #F59E0B; }
QLabel#saveChipText {
    color: inherit;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#saveChipDirtyDot {
    background: #E8B44C;
    border-radius: 3px;
}
QPushButton#contextIndicator {
    background: transparent;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 1px 6px;
}
QPushButton#contextIndicator:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QLabel#contextRow {
    color: #A69F94;
    font-size: 11px;
    background: transparent;
}
QPushButton#appBarUtility {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px;
}
QPushButton#appBarUtility:hover { background: rgba(245,158,11,0.07); }
QPushButton#appBarUtility:checked { background: rgba(245,158,11,0.12); }
/* uiux-audit-remediation 2.2 (design D4): warning affordance tri-state via
   the `warnState` property — none (hidden), unread (accent highlighted),
   acknowledged (dimmed but visible while unresolved). */
QPushButton#appBarWarnBtn {
    background: rgba(232,180,76,0.12);
    border: 1px solid rgba(232,180,76,0.35);
}
QPushButton#appBarWarnBtn[warnState="unread"] {
    background: rgba(232,180,76,0.12);
    border: 1px solid #E8B44C;
}
QPushButton#appBarWarnBtn[warnState="unread"]:hover {
    background: rgba(232,180,76,0.35);
}
QPushButton#appBarWarnBtn[warnState="acknowledged"] {
    background: transparent;
    border: 1px solid transparent;
}
QPushButton#appBarWarnBtn[warnState="acknowledged"]:hover {
    background: rgba(245,158,11,0.07);
}
QPushButton#windowControlBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}
QPushButton#windowControlBtn:hover { background: rgba(245,158,11,0.07); }
QPushButton#windowControlBtn[danger="true"]:hover { background: rgba(248,113,113,0.12); }

/* ---- shell v3 nav strip (top-nav-shell 3.1) ---- */
QWidget#navStrip {
    background: #1B1917;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QPushButton#navTab {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 0;
    border-bottom: 2px solid transparent;
    padding: 4px 10px 3px 10px;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
}
QPushButton#navTab:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#navTab:checked {
    color: #F59E0B;
    border-bottom: 2px solid #F59E0B;
}
QPushButton#navTab:focus {
    outline: none;
    color: #ECE7E0;
}
/* uiux-audit-remediation 1.3: primary-tier zone destinations. The
   active-zone treatment is amber text only — the amber underline stays
   reserved for the active secondary tab. */
QPushButton#navZoneTab {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 0;
    border-bottom: 2px solid transparent;
    padding: 4px 10px 3px 10px;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
}
QPushButton#navZoneTab:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#navZoneTab:pressed {
    background: rgba(245,158,11,0.12);
}
QPushButton#navZoneTab:checked {
    color: #F59E0B;
}
QPushButton#navZoneTab:checked:hover {
    color: #F7B03A;
}
QPushButton#navZoneTab:focus {
    outline: none;
    color: #ECE7E0;
}
QPushButton#navZoneTab:checked:focus {
    color: #F59E0B;
}
QToolButton#navOverflowBtn {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 6px;
    padding: 2px 8px;
    font-weight: 600;
}
QToolButton#navOverflowBtn:hover { background: rgba(245,158,11,0.07); color: #F59E0B; }
QLabel#tableEmptyHint {
    color: #5C564E;
    font-size: 14px;
    background: transparent;
}
QSplitter::handle:horizontal {
    background: rgba(236,231,224,0.1);
    width: 2px;
}
QSplitter::handle:horizontal:hover { background: rgba(245,158,11,0.3); width: 4px; }
QSplitter::handle:vertical {
    background: rgba(236,231,224,0.1);
    height: 2px;
}
QSplitter::handle:vertical:hover { background: rgba(245,158,11,0.3); height: 4px; }

/* ---- scrollbars ---- */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 10px;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: rgba(236,231,224,0.18);
    min-height: 24px;
    min-width: 24px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #5C564E;
}
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
    background: rgba(245,158,11,0.3);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0; width: 0; background: none; border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ---- tabs ---- */
QTabWidget::pane {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 12px;
    margin-top: -1px;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-right: 4px;
    color: #A69F94;
    font-weight: 600;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #F59E0B;
    border-bottom: 2px solid #F59E0B;
}
QTabBar::tab:hover:!selected {
    color: #ECE7E0;
    background: rgba(245,158,11,0.07);
    border-radius: 6px 6px 0 0;
}
QTabBar::close-button { image: none; subcontrol-position: right; }

/* ---- dialogs & system surfaces (022 sheet grammar) ---- */
QDialog {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
}
QLabel#dialogKicker {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#dialogTitle {
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px;
    font-weight: 600;
    color: #ECE7E0;
}
QLabel#workflowStep {
    color: #5C564E;
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#workflowStep[stepState="active"] {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.3);
}
QLabel#workflowStep[stepState="complete"] {
    color: #2DD4BF;
    border-color: rgba(45,212,191,0.3);
}
QFrame#guildMembersPane {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QLabel#operationSummary {
    color: #ECE7E0;
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 16px;
    font-size: 14px;
    font-weight: 600;
}
QLabel#operationResult {
    color: #ECE7E0;
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 12px;
}
QLabel#operationResult[resultState="success"] {
    color: #2DD4BF; border-color: rgba(45,212,191,0.3);
}
QLabel#operationResult[resultState="warning"] {
    color: #E8B44C; border-color: rgba(232,180,76,0.35);
}
QMessageBox, QInputDialog {
    background-color: #211E1B;
    color: #ECE7E0;
}
QMessageBox QLabel, QInputDialog QLabel { color: #ECE7E0; }
QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 5px 14px;
    min-width: 72px;
    font-weight: 600;
}
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QFileDialog {
    background-color: #141312;
    color: #ECE7E0;
}
QFileDialog QLabel { color: #A69F94; }
QFileDialog QLineEdit {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 5px 8px;
}
QFileDialog QTreeView {
    background: #1B1917;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
}
QFileDialog QComboBox {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 4px 8px;
}
QListView { background: transparent; }
QColumnView { background: transparent; }
QTextBrowser { background: transparent; color: #ECE7E0; }

/* ---- shared component classes (ui/chrome/components.py sets these) ---- */
QFrame[class="panel"] {
    background-color: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame[class="card"] {
    background-color: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame[class="card"][selected="true"] {
    border-color: rgba(245,158,11,0.3);
    background-color: rgba(245,158,11,0.1);
}
QFrame[class="divider"] { background: rgba(236,231,224,0.1); max-height: 1px; border: none; }
QFrame[class="divider"][vertical="true"] { max-height: none; max-width: 1px; }

QLabel[class="display"] {
    font-size: 24px; font-weight: 600; color: #ECE7E0;
    letter-spacing: -0.01em;
}
QLabel[class="title"] {
    font-size: 17px; font-weight: 600; color: #ECE7E0;
}
QLabel[class="section"] {
    font-size: 14px; font-weight: 600;
    color: #ECE7E0;
}
QLabel[class="secondary"] { color: #A69F94; font-size: 12px; }
QLabel[class="micro"] { color: #A69F94; font-size: 11px; }
QLabel[class="mono"] { font-family: 'Cascadia Mono','Consolas'; }

QLabel[badge="neutral"] {
    background: #211E1B; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="success"] {
    background: rgba(45,212,191,0.1); color: #2DD4BF;
    border: 1px solid rgba(45,212,191,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="warning"] {
    background: rgba(232,180,76,0.12); color: #E8B44C;
    border: 1px solid rgba(232,180,76,0.35); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="danger"] {
    background: rgba(248,113,113,0.12); color: #F87171;
    border: 1px solid rgba(248,113,113,0.35); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="info"] {
    background: rgba(147,183,221,0.1); color: #93B7DD;
    border: 1px solid rgba(147,183,221,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="special"] {
    background: rgba(192,132,252,0.12); color: #C084FC;
    border: 1px solid rgba(192,132,252,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}
QLabel[badge="accent"] {
    background: rgba(245,158,11,0.1); color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 11px; font-weight: 600;
}

QLabel[class="dot"][level="success"] { background: #2DD4BF; }
QLabel[class="dot"][level="warning"] { background: #E8B44C; }
QLabel[class="dot"][level="danger"] { background: #F87171; }
QLabel[class="dot"][level="info"] { background: #93B7DD; }
QLabel[class="dot"][level="special"] { background: #C084FC; }
QLabel[class="dot"][level="neutral"] { background: #5C564E; }
QLabel[class="dot"][level="accent"] { background: #F59E0B; }

QFrame[class="errorBanner"] {
    background: rgba(248,113,113,0.12);
    border: 1px solid rgba(248,113,113,0.35);
    border-radius: 8px;
}
QFrame[class="errorBanner"] QLabel { color: #F87171; }

QFrame[class="toast"][toast_level="success"] {
    background: rgba(45,212,191,0.1); border: 1px solid rgba(45,212,191,0.3); border-radius: 6px;
}
QFrame[class="toast"][toast_level="warning"] {
    background: rgba(232,180,76,0.12); border: 1px solid rgba(232,180,76,0.35); border-radius: 6px;
}
QFrame[class="toast"][toast_level="danger"] {
    background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.35); border-radius: 6px;
}
QFrame[class="toast"][toast_level="info"] {
    background: rgba(147,183,221,0.1); border: 1px solid rgba(147,183,221,0.3); border-radius: 6px;
}
QFrame[class="toast"] QLabel { font-size: 12px; font-weight: 600; }
QFrame[class="toast"][toast_level="success"] QLabel { color: #2DD4BF; }
QFrame[class="toast"][toast_level="warning"] QLabel { color: #E8B44C; }
QFrame[class="toast"][toast_level="danger"] QLabel { color: #F87171; }
QFrame[class="toast"][toast_level="info"] QLabel { color: #93B7DD; }

QFrame[class="searchField"] {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame[class="searchField"] QLineEdit {
    background: transparent; border: none; padding: 2px 0;
}
QFrame[class="searchField"] QLineEdit:focus { border: none; }
QFrame[class="searchField"] QLabel { color: #A69F94; }

/* ---- workspace header and context ---- */
QFrame#workspaceHeader {
    background: #1B1917;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    padding: 16px 24px 8px;
}
QLabel#workspaceTitle {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 24px;
    font-weight: 600;
}
QLabel#workspaceDescription { color: #A69F94; font-size: 12px; }
QPushButton#workspaceSaveContext {
    background: #211E1B; color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 8px;
    padding: 4px 12px; text-align: left;
}
QPushButton#workspaceSaveContext:hover { background: rgba(245,158,11,0.07); border-color: rgba(236,231,224,0.18); }
QPushButton#workspaceSaveContext:pressed { background: rgba(245,158,11,0.12); }
QPushButton#workspaceSaveContext:focus { border: 2px solid #F7B03A; }
QPushButton#workspaceSaveContext:disabled { color: #5C564E; border-color: rgba(236,231,224,0.1); }
QPushButton#workspaceSaveContext[saveState="loaded"] { border-color: rgba(45,212,191,0.3); }
QPushButton#workspaceSaveContext[saveState="dirty"], QPushButton#workspaceSaveContext[saveState="read_only"], QPushButton#workspaceSaveContext[saveState="backup_recommended"] { border-color: rgba(232,180,76,0.35); }
QPushButton#workspaceSaveContext[saveState="error"] { border-color: rgba(248,113,113,0.35); }
QPushButton#workspaceSaveContext[saveState="loading"], QPushButton#workspaceSaveContext[saveState="saving"] { border-color: rgba(147,183,221,0.3); }
QPushButton#pendingChangesButton {
    background: transparent; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 9999px;
    padding: 4px 12px;
}
QPushButton#pendingChangesButton:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton#pendingChangesButton:pressed { background: rgba(245,158,11,0.12); }
QPushButton#pendingChangesButton:focus { border: 2px solid #F7B03A; }
QPushButton#pendingChangesButton:disabled { color: #5C564E; }
QPushButton#pendingChangesButton[hasChanges="true"] { color: #E8B44C; border-color: rgba(232,180,76,0.35); background: rgba(232,180,76,0.12); }
QFrame#workspaceContextBar { background: transparent; }
QLabel[class="contextSeparator"] { color: #5C564E; font-size: 12px; }
QFrame#notificationHost { background: transparent; }

/* ---- workspace shell ---- */
QFrame#workspaceShell, QFrame#workspaceArea, QFrame#workspaceContent {
    background: #141312;
}
QFrame#shellTitleBar {
    background: #171513;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QFrame#windowDragRegion { background: transparent; border: none; }
QLabel#windowDragLabel {
    color: #5C564E;
    font-size: 11px;
}
QStackedWidget#workspacePageHost { background: transparent; border: none; }
QFrame#workspaceInspectorSide {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QWidget#overviewPage, QWidget#overviewBody, QWidget#overviewNoSaveBody,
QScrollArea#overviewScroll, QScrollArea#overviewNoSaveScroll,
QScrollArea#overviewScroll > QWidget > QWidget,
QScrollArea#overviewNoSaveScroll > QWidget > QWidget { background: transparent; border: none; }
QFrame#overviewIdentity, QFrame#overviewActivity, QFrame#overviewWelcome,
QFrame#overviewRecentSaves {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QLabel#overviewWelcomeTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 24px; font-weight: 600;
}
QLabel#overviewWelcomeDescription, QLabel#overviewRecentDetail,
QLabel#overviewRecentEmpty { color: #A69F94; font-size: 14px; }
QLabel#overviewDropHint {
    color: #A69F94; background: #141312;
    border: 1px dashed rgba(236,231,224,0.18); border-radius: 8px;
    padding: 16px;
}
QFrame#overviewRecentRow {
    background: #211E1B; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#overviewRecentRow[available="false"] { border-color: rgba(232,180,76,0.35); }
QLabel#overviewRecentName { color: #ECE7E0; font-size: 14px; font-weight: 600; }
QLabel#overviewSaveName {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel#overviewSaveDetail { color: #A69F94; font-size: 12px; }
QLabel#overviewBackupState, QLabel#overviewPendingState {
    color: #A69F94; background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 9999px;
    padding: 4px 12px;
}
QLabel#overviewPendingState[hasChanges="true"] { color: #E8B44C; border-color: rgba(232,180,76,0.35); }
QPushButton#overviewMetric {
    background: #1B1917; color: #ECE7E0; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px; text-align: left; padding: 16px;
    font-size: 17px; font-weight: 600;
}
QPushButton#overviewMetric:hover { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.3); }
QPushButton#overviewMetric:pressed { background: rgba(245,158,11,0.12); }
QPushButton#overviewMetric:focus { border: 2px solid #F7B03A; }
QLabel[class="sectionTitle"] {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QFrame#overviewActivity QLabel { color: #A69F94; font-size: 14px; }

QWidget#toolCenterPage, QWidget#toolCenterBody, QScrollArea#toolCenterScroll,
QScrollArea#toolCenterScroll > QWidget > QWidget { background: transparent; border: none; }
QWidget#toolCenterPage QPushButton[class="chip"]:checked {
    background: #F59E0B; color: #1C1206;
    border-color: #F59E0B;
}
QFrame#toolCenterCard {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame#toolCenterCard:hover { border-color: rgba(236,231,224,0.18); }
QFrame#toolCenterCard[ready="false"] { background: #211E1B; }
QLabel#toolCenterTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel#toolCenterDescription { color: #A69F94; font-size: 14px; }
QLabel#toolCenterIo { color: #5C564E; font-size: 12px; }
QLabel#toolCenterRequirement { color: #2DD4BF; font-size: 12px; font-weight: 600; }
QFrame#toolCenterCard[ready="false"] QLabel#toolCenterRequirement { color: #E8B44C; }
QLabel#toolCenterEmpty { color: #A69F94; font-size: 14px; padding: 24px; }

QWidget#settingsPage, QWidget#settingsBody, QScrollArea#settingsScroll,
QScrollArea#settingsScroll > QWidget > QWidget { background: transparent; border: none; }
QFrame#settingsSection {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame#settingsSection:focus-within { border-color: rgba(236,231,224,0.18); }
QLabel#settingsSectionTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel#settingsSectionHelp, QLabel#settingsStatus {
    color: #A69F94; font-size: 12px;
}
QFrame#settingsSection QCheckBox { padding: 4px 0; }

QWidget#aboutPage, QWidget#aboutBody, QScrollArea#aboutScroll,
QScrollArea#aboutScroll > QWidget > QWidget,
QWidget#diagnosticsPage, QWidget#diagnosticsBody, QScrollArea#diagnosticsScroll,
QScrollArea#diagnosticsScroll > QWidget > QWidget { background: transparent; border: none; }
QFrame#aboutHero, QFrame#aboutCard, QFrame#systemUpdateBanner,
QFrame#diagnosticsSummary, QFrame#diagnosticsPaths,
QFrame#diagnosticsReport, QFrame#diagnosticsConsole {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QLabel#aboutProductTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 24px; font-weight: 600;
}
QLabel#aboutDescription, QLabel#aboutCardBody {
    color: #A69F94; font-size: 14px;
}
QLabel#aboutCardTitle, QLabel#diagnosticsSectionTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QFrame#systemUpdateBanner[status="available"] {
    background: rgba(232,180,76,0.12); border-color: rgba(232,180,76,0.35);
}
QFrame#systemUpdateBanner[status="current"] {
    background: rgba(45,212,191,0.1); border-color: rgba(45,212,191,0.3);
}
QFrame#systemUpdateBanner[status="error"] {
    background: rgba(248,113,113,0.12); border-color: rgba(248,113,113,0.35);
}
QLabel#diagnosticsValue, QLabel#diagnosticsPath {
    color: #ECE7E0; font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}
QFrame#diagnosticsPathRow {
    background: #211E1B; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QLabel#diagnosticsPrivacy { color: #A69F94; }
QLabel#diagnosticsResult[status="success"] { color: #2DD4BF; }
QLabel#diagnosticsResult[status="warning"] { color: #E8B44C; }
QLabel#diagnosticsResult[status="danger"] { color: #F87171; }
QPlainTextEdit#diagnosticsConsoleOutput {
    background: #141312; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 8px;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}

QWidget#activityPage, QWidget#activityBody, QScrollArea#activityScroll,
QScrollArea#activityScroll > QWidget > QWidget { background: transparent; border: none; }
QLabel#activityCount { color: #A69F94; font-size: 12px; }
QFrame#activityRow {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-left: 3px solid #93B7DD; border-radius: 10px;
}
QFrame#activityRow[status="success"] { border-left-color: #2DD4BF; }
QFrame#activityRow[status="warning"] { border-left-color: #E8B44C; }
QFrame#activityRow[status="failed"] { border-left-color: #F87171; }
QFrame#activityRow[status="undone"] { border-left-color: #5C564E; }
QLabel#activityTime {
    color: #5C564E; font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}
QLabel#activityTitle {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel#activityContext { color: #A69F94; font-size: 14px; }
QLabel#activityDetail {
    color: #A69F94; background: #141312;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 6px;
    padding: 8px;
}

QWidget#backupsPage, QWidget#backupsBody, QScrollArea#backupsScroll,
QScrollArea#backupsScroll > QWidget > QWidget { background: transparent; border: none; }
QLabel#backupCount { color: #A69F94; font-size: 12px; }
QFrame#backupRow {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame#backupRow:hover { border-color: rgba(236,231,224,0.18); }
QLabel#backupTimestamp {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel#backupReason { color: #A69F94; font-size: 14px; }
QLabel#backupSize {
    color: #5C564E; font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}
QFrame#backupProgress { max-height: 156px; }

QWidget#playersPage, QWidget#basesPage, QWidget#guildsPage, QWidget#exclusionsPage, QWidget#entityBrowserFrame {
    background: transparent; border: none;
}

/* ---- standardized state surfaces ---- */
QFrame[class="stateView"], QFrame[class="skeletonView"] {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QLabel[class="stateIcon"] { background: transparent; }
QLabel[class="stateTitle"] {
    color: #ECE7E0; font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px; font-weight: 600;
}
QLabel[class="stateMessage"] { color: #A69F94; font-size: 14px; }
QFrame[class="stateView"][stateKind="prerequisite"] { border-color: rgba(232,180,76,0.35); }
QFrame[class="stateView"][stateKind="error"], QFrame[class="stateView"][stateKind="operation_error"] { border-color: rgba(248,113,113,0.35); }
QFrame[class="stateView"][stateKind="operation_success"] { border-color: rgba(45,212,191,0.3); }
QFrame[class="skeletonLine"] { background: #211E1B; border-radius: 6px; }
QFrame[class="skeletonLine"][lineLength="short"] { max-width: 240px; }
QFrame[class="blockingProgress"] {
    background: #2A2623; border: 1px solid rgba(236,231,224,0.18);
    border-radius: 12px;
}
QFrame[class="notificationBanner"] {
    background: #211E1B; border: 1px solid rgba(147,183,221,0.3);
    border-radius: 8px;
}
QFrame[class="notificationBanner"][level="success"] { background: rgba(45,212,191,0.1); border-color: rgba(45,212,191,0.3); }
QFrame[class="notificationBanner"][level="warning"] { background: rgba(232,180,76,0.12); border-color: rgba(232,180,76,0.35); }
QFrame[class="notificationBanner"][level="danger"] { background: rgba(248,113,113,0.12); border-color: rgba(248,113,113,0.35); }
QFrame[class="notificationBanner"][level="info"] { background: rgba(147,183,221,0.1); border-color: rgba(147,183,221,0.3); }

QDialog#baseDialog { background: #2A2623; color: #ECE7E0; }
QDialog#baseDialog[riskVariant="destructive"] { border: 1px solid rgba(248,113,113,0.35); }
QFrame#contextDrawer {
    background: #2A2623; border-left: 1px solid rgba(236,231,224,0.18);
}
QFrame#contextDrawer[riskVariant="warning"] { border-left-color: #E8B44C; }
QFrame#contextDrawer[riskVariant="destructive"] { border-left-color: #F87171; }

/* ---- shared inventory slots and Pal cards ---- */
QFrame#inventoryGridToolbar {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#inventoryGridToolbar QLabel#sectionHeader {
    color: #ECE7E0;
    font-size: 12px;
    font-weight: 600;
    padding-right: 4px;
}
QFrame#inventoryGridToolbar QLabel#inventoryFilterCount {
    color: #A69F94;
    font-size: 12px;
}
QFrame#invMultiToolbar { background: transparent; border: none; }
QWidget#auditInventoryGrid { background: transparent; }
QFrame#auditInventorySlot, QFrame#auditPalCard {
    background: #1B1917; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#auditInventorySlot:hover, QFrame#auditPalCard:hover {
    background: rgba(245,158,11,0.07); border-color: rgba(236,231,224,0.18);
}
QFrame#auditInventorySlot:focus, QFrame#auditPalCard:focus {
    border: 2px solid #F7B03A;
}
QFrame#auditInventorySlot[selected="true"], QFrame#auditPalCard[selected="true"] {
    background: rgba(245,158,11,0.18); border: 2px solid #F59E0B;
}
QFrame#auditInventorySlot[empty="true"] { background: #141312; border-style: dashed; }
QFrame#auditInventorySlot[rarity="1"], QFrame#auditPalCard[rarity="1"] { border-color: rgba(45,212,191,0.3); }
QFrame#auditInventorySlot[rarity="2"], QFrame#auditPalCard[rarity="2"] { border-color: rgba(147,183,221,0.3); }
QFrame#auditInventorySlot[rarity="3"], QFrame#auditPalCard[rarity="3"] { border-color: rgba(192,132,252,0.3); }
QFrame#auditInventorySlot[rarity="4"], QFrame#auditPalCard[rarity="4"] { border-color: rgba(232,180,76,0.35); }
QLabel#slotPortrait, QLabel#palCardPortrait { background: #211E1B; border-radius: 6px; }
QLabel#slotName { color: #A69F94; font-size: 11px; }
QLabel#slotQuantity { color: #ECE7E0; font-size: 12px; font-weight: 600; }
QLabel#slotBadge {
    color: #A69F94; font-size: 11px;
    background: #211E1B; border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px; padding: 1px 4px;
}
QFrame#auditInventorySlot[equipmentSlot="true"] { min-width: 72px; }
QFrame#auditInventorySlot[equipmentSlot="true"][locked="true"] {
    background: rgba(232,180,76,0.12); border-style: dashed;
    border-color: rgba(232,180,76,0.35);
}
QLabel#equipmentWorkspaceTitle, QLabel#equipmentCategoryHeader {
    color: #ECE7E0; font-size: 12px; font-weight: 600;
}
QLabel#equipmentCategoryHeader { color: #A69F94; }
QLabel#inventorySelectionPreview, QLabel#equipmentSelectionPreview {
    color: #A69F94; font-size: 12px;
}
QLabel#slotQuantity[rarity="1"], QLabel#palCardLevel[rarity="1"] { color: #2DD4BF; }
QLabel#slotQuantity[rarity="2"], QLabel#palCardLevel[rarity="2"] { color: #93B7DD; }
QLabel#slotQuantity[rarity="3"], QLabel#palCardLevel[rarity="3"] { color: #C084FC; }
QLabel#slotQuantity[rarity="4"], QLabel#palCardLevel[rarity="4"] { color: #E8B44C; }
QLabel#palCardName { color: #ECE7E0; font-size: 14px; font-weight: 600; }
QLabel#palCardLevel { color: #A69F94; font-size: 12px; font-weight: 600; }
QLabel#palCardMeta { color: #A69F94; font-size: 11px; }

/* ---- shell hairline (reused by search panels / tools sections) ---- */
QFrame#bandZoneRule {
    background: rgba(236,231,224,0.1);
    border: none;
    margin: 3px 10px;
}
QLabel#trayLabel {
    color: #5C564E;
    font-size: 11px;
}

/* ---- TrayDrawer overlay (canvas-local, plan 020 §4.2) ---- */
QFrame#trayDrawer {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 10px;
}
QLabel#drawerTitle {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px;
    font-weight: 600;
}
QPushButton#drawerCloseBtn {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    color: #A69F94;
}
QPushButton#drawerCloseBtn:hover { background: rgba(248,113,113,0.12); color: #F87171; border-color: rgba(248,113,113,0.35); }

/* ---- workspace sidebar ---- */
QWidget#sideBar {
    background-color: #171513;
    border-right: 1px solid rgba(236,231,224,0.1);
}
QWidget#sidebarContent, QScrollArea#sidebarScroll, QScrollArea#sidebarScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}
QLabel#sidebarBrand {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px;
    font-weight: 600;
}
QLabel#sidebarSection {
    color: #5C564E;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 8px 12px 4px;
}
QPushButton[sidebarItem="true"] {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    text-align: left;
    padding: 0px 12px;
}
QWidget#sideBar[collapsed="true"] QPushButton[sidebarItem="true"] {
    text-align: center;
    padding: 0px;
}
QPushButton[sidebarItem="true"]:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[sidebarItem="true"]:focus {
    border: 2px solid #F7B03A;
}
QPushButton[sidebarItem="true"]:pressed {
    background: rgba(245,158,11,0.12);
}
QPushButton[sidebarItem="true"][active="true"] {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
}
QPushButton[sidebarItem="true"][active="true"]:hover {
    background: rgba(245,158,11,0.18);
    color: #F7B03A;
}
QPushButton[sidebarItem="true"]:disabled {
    color: #5C564E;
    background: transparent;
}
QPushButton[sidebarItem="true"][prerequisiteMissing="true"] {
    color: #5C564E;
}

/* header chips: neutral by default, semantic only where meaning exists */
QPushButton#menuChip, QLabel#versionChip, QLabel#gameVersionChip {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 4px 10px;
    color: #A69F94;
}
QPushButton#menuChip:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#menuChip:pressed { background: rgba(245,158,11,0.12); }
QPushButton#menuChip:disabled { color: #5C564E; background: #1B1917; }
QLabel#versionChip[pulse="true"] {
    background: rgba(232,180,76,0.12);
    border-color: rgba(232,180,76,0.35);
    color: #E8B44C;
}
QPushButton#controlChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #A69F94;
    text-align: center;
}
QPushButton#controlChip:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#controlChip:pressed { background: rgba(245,158,11,0.12); }
QPushButton#controlChip:disabled { color: #5C564E; }
QPushButton#controlChip[role="close"] { color: #A69F94; }
QPushButton#controlChip[role="close"]:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}

/* header action buttons: one tool-chip style; warn/save carry semantics */
QPushButton#hdrBtn, QPushButton#infoBtn, QPushButton#warnBtn, QPushButton#saveBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #A69F94;
    text-align: center;
}
QPushButton#hdrBtn:hover, QPushButton#infoBtn:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#hdrBtn:pressed, QPushButton#infoBtn:pressed { background: rgba(245,158,11,0.12); }
QPushButton#hdrBtn:disabled, QPushButton#infoBtn:disabled, QPushButton#saveBtn:disabled {
    color: #5C564E;
}
QPushButton#warnBtn {
    background: rgba(232,180,76,0.12);
    border-color: rgba(232,180,76,0.35);
    color: #E8B44C;
}
QPushButton#warnBtn:hover { background: rgba(232,180,76,0.12); border-color: #E8B44C; color: #ECE7E0; }
QPushButton#warnBtn:pressed { background: rgba(232,180,76,0.35); }
QPushButton#saveBtn {
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
}
QPushButton#saveBtn:hover { background: rgba(245,158,11,0.18); border-color: rgba(245,158,11,0.5); color: #ECE7E0; }
QPushButton#saveBtn:pressed { background: rgba(245,158,11,0.3); }
QPushButton#saveBtn[dirty="true"] {
    background: rgba(45,212,191,0.1);
    border-color: rgba(45,212,191,0.3);
    color: #2DD4BF;
}
QPushButton#saveBtn[dirty="true"]:hover { background: rgba(45,212,191,0.1); border-color: #2DD4BF; color: #ECE7E0; }
QPushButton#discordChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #93B7DD;
}
QPushButton#discordChip:hover { background: rgba(147,183,221,0.1); border-color: rgba(147,183,221,0.3); }

/* detached console */
QFrame#mainContainer {
    background: #1B1917;
    border-radius: 10px;
    border: 1px solid rgba(236,231,224,0.1);
}
QTextEdit#consoleTextEdit {
    background: #141312;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(245,158,11,0.18);
    font-family: 'Cascadia Mono','Consolas';
}
QLabel#consoleTitleLabel {
    font-weight: 600;
    font-size: 14px;
    color: #ECE7E0;
    background: transparent;
}
QPushButton#consoleCloseBtn {
    background: transparent;
    color: #A69F94;
    font-size: 14px;
    font-weight: 600;
    border: none;
    padding: 5px;
}
QPushButton#consoleCloseBtn:hover {
    background: rgba(248,113,113,0.12);
    border-radius: 6px;
    color: #F87171;
}
QPushButton#detachButton, QPushButton#attachButton {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 4px 8px;
    color: #A69F94;
}
QPushButton#detachButton:hover, QPushButton#attachButton:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#detachButton:pressed, QPushButton#attachButton:pressed { background: rgba(245,158,11,0.12); }
QPushButton#collapseToggle {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    color: #A69F94;
}
QPushButton#collapseToggle:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#collapseToggle:pressed { background: rgba(245,158,11,0.12); }

/* results dock */
QWidget#resultsWidget { background: transparent; }
QPushButton#resultsCloseBtn {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
}
QPushButton#resultsCloseBtn:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}
QPushButton#resultsCloseBtn:pressed { background: rgba(248,113,113,0.35); }
QPushButton#copyStatsBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    color: #A69F94;
    padding: 2px;
}
QPushButton#copyStatsBtn:hover {
    background: rgba(245,158,11,0.07);
    border-radius: 6px;
    color: #ECE7E0;
}
QLabel#statsHeaderLabel { color: #ECE7E0; font-weight: 600; }
QLabel#statsFieldLabel { color: #A69F94; }
QLabel#statsValueLabel { color: #ECE7E0; font-weight: 600; }
QLabel#statsValueLabel[placeholder="true"] { color: #5C564E; font-weight: 400; }

/* ---- search screens ---- */
QLineEdit#searchInput {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 4px 10px;
    color: #ECE7E0;
    font-size: 12px;
    min-height: 28px;
}
QLineEdit#searchInput:focus { border-color: rgba(245,158,11,0.5); }

/* ---- map hover overlays (top-nav-shell 5.2: re-tokened from legacy cyan) ---- */
QWidget#popupSurface, QFrame#popupSurface, QFrame#menuPopupContainer {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 10px;
}
QWidget#popupContent { background: transparent; }
QWidget#menuPopupButton, QWidget#popupGroupHeader {
    background: transparent;
    border: none;
    border-radius: 8px;
}
QWidget#menuPopupButton[hovered="true"],
QWidget#popupGroupHeader[hovered="true"] {
    background: rgba(245,158,11,0.07);
}
QWidget#menuPopupButton[active="true"],
QWidget#popupGroupHeader[active="true"] {
    background: rgba(245,158,11,0.12);
    border-left: 3px solid #F59E0B;
}
QWidget#menuPopupButton QLabel, QWidget#popupGroupHeader QLabel {
    color: #A69F94;
    background: transparent;
    border: none;
}
QWidget#menuPopupButton[hovered="true"] QLabel,
QWidget#menuPopupButton[active="true"] QLabel,
QWidget#popupGroupHeader[hovered="true"] QLabel,
QWidget#popupGroupHeader[active="true"] QLabel { color: #ECE7E0; }
QPushButton#popupMenuItem {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #A69F94;
    min-height: 24px;
    padding: 8px 12px;
    text-align: left;
}
QPushButton#popupMenuItem:hover,
QPushButton#popupMenuItem:focus {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#popupMenuItem:checked {
    background: rgba(245,158,11,0.12);
    color: #F59E0B;
}
QFrame#popupSeparator {
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
    margin: 4px 8px;
}
QLabel#popupMenuLabel {
    color: #A69F94;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
    background: transparent;
    border: none;
}
QMenu#appContextMenu {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 10px;
    padding: 8px;
    color: #A69F94;
}
QMenu#appContextMenu::item {
    padding: 8px 12px;
    min-height: 24px;
    border-radius: 6px;
}
QMenu#appContextMenu::item:selected {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QMenu#appContextMenu::item:checked {
    background: rgba(245,158,11,0.12);
    color: #F59E0B;
}
QMenu#appContextMenu::separator {
    height: 1px;
    background: rgba(236,231,224,0.1);
    margin: 4px 8px;
}
QFrame#hoverOverlayContainer {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 10px;
}
QLabel#hoverGuildLabel {
    color: #F59E0B;
    font-weight: 600;
}
QLabel#hoverNameLabel {
    color: #F59E0B;
    font-weight: 600;
}
QLabel#hoverDetailLabel {
    color: #A69F94;
}

/* ---- pal editor container (top-nav-shell 5.2: re-tokened from legacy cyan) ---- */
QWidget#editPalsContainer {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QWidget#editPalsContent {
    background: transparent;
}
QFrame#bulkActionBar {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 8px;
}
QLabel#bulkActionLabel { font-weight: 600; color: #A69F94; }
QLabel#bulkHintLabel { color: #A69F94; font-size: 12px; }
QLabel#searchCount {
    color: #5C564E;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 11px;
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 1px 8px;
}
QFrame#tableFooter {
    background: #1B1917;
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
}
QPushButton#pageSwitchBtn {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    color: #A69F94;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#pageSwitchBtn:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton#pageSwitchBtn:checked {
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
    font-weight: 600;
}
QPushButton#pageSwitchBtn:focus { border-color: rgba(245,158,11,0.5); }
/* uiux-audit-remediation 8.2 (design D10): context selectors render as
   bordered dropdown chips (chevron icon set in code); the picker-selected
   accent state mirrors the retired ghostBtn[pickerSelected] treatment. */
QPushButton#selectorChip {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 9999px;
    color: #A69F94;
    padding: 5px 12px;
    font-weight: 600;
}
QPushButton#selectorChip:hover {
    border-color: rgba(245,158,11,0.3);
    color: #ECE7E0;
}
QPushButton#selectorChip:disabled { color: #5C564E; border-color: rgba(236,231,224,0.1); }
QPushButton#selectorChip[pickerSelected="true"] {
    border-color: rgba(245,158,11,0.5);
    color: #F59E0B;
}
/* Inventory editor context belongs to the workspace, not a page ribbon. */
QFrame#editorContextBar {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QLabel#editorContextLabel {
    color: #A69F94;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#editorContextHint {
    color: #5C564E;
    font-size: 12px;
}
QLabel#contextHierarchySeparator {
    color: #5C564E;
    font-size: 17px;
    padding: 0 4px;
}
QFrame#workspaceViewTabs {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#baseInventoryFilterGroup, QFrame#baseInventoryActionGroup {
    background: transparent;
    border: none;
}
QPushButton#workspacePlayerSelector {
    min-height: 24px;
    text-align: left;
}
QPushButton#workspacePlayerSelector[pickerSelected="true"] {
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.5);
    color: #F59E0B;
}
QPushButton#workspacePlayerSelector:focus {
    border: 2px solid #F7B03A;
}
/* uiux-audit-remediation 8.2 (design D10): view modes render as underlined
   tabs — transparent body, active = accent text + bottom underline. */
QPushButton#viewTabBtn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: #A69F94;
    padding: 4px 12px;
    font-weight: 600;
}
QPushButton#viewTabBtn:hover {
    color: #ECE7E0;
}
QPushButton#viewTabBtn:checked {
    color: #F59E0B;
    border-bottom: 2px solid #F59E0B;
}
QPushButton#viewTabBtn:focus { outline: none; color: #ECE7E0; }
QPushButton#viewTabBtn:checked:focus { color: #F59E0B; }
/* uiux-audit-remediation 8.3: muted section label separating dropped-item
   debris from meaningful storage in the container list. */
QLabel#containerGroupLabel {
    color: #5C564E;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#containerNavigatorTitle {
    color: #ECE7E0;
    font-size: 12px;
    font-weight: 600;
}
QLabel#containerSelectionSummary {
    color: #5C564E;
    font-size: 12px;
}
QTreeWidget#containerNavigator {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
    color: #ECE7E0;
    outline: none;
}
QTreeWidget#containerNavigator::item {
    padding: 8px;
    margin: 1px 2px;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    background: #1B1917;
}
QTreeWidget#containerNavigator::item:selected {
    background: rgba(245,158,11,0.1);
    border: 2px solid #F59E0B;
}
QTreeWidget#containerNavigator::item:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QTreeWidget#containerNavigator::branch { background: transparent; }
QWidget#containerRow, QWidget#containerGroupRow { background: transparent; }
QLabel#containerThumbnail {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QLabel#containerName {
    color: #ECE7E0;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#containerMeta {
    color: #A69F94;
    font-size: 12px;
    background: transparent;
}
QPushButton#ghostBtn, QPushButton#toolButton {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    color: #A69F94;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#ghostBtn:hover, QPushButton#toolButton:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
    border-color: rgba(236,231,224,0.18);
}
QPushButton#ghostBtn:pressed, QPushButton#toolButton:pressed { background: rgba(245,158,11,0.12); }
QPushButton#ghostBtn:disabled, QPushButton#toolButton:disabled { color: #5C564E; }
/* modernize-tab-ui 2.5: selected state for picker buttons (accent border) */
QPushButton#ghostBtn[pickerSelected="true"] {
    border-color: rgba(245,158,11,0.5);
    color: #F59E0B;
}
/* modernize-tab-ui 3.3: warning-tier bulk actions (Unlock All Fast Travel) */
QPushButton#warnActionBtn {
    background: transparent;
    border: 1px solid rgba(232,180,76,0.35);
    border-radius: 6px;
    color: #E8B44C;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#warnActionBtn:hover {
    background: rgba(232,180,76,0.12);
    border-color: #E8B44C;
    color: #ECE7E0;
}
QPushButton#warnActionBtn:pressed { background: rgba(245,158,11,0.12); }
QPushButton#warnActionBtn:disabled { color: #5C564E; border-color: rgba(236,231,224,0.1); }
QFrame#invToolbarSep {
    background: rgba(236,231,224,0.1);
    max-width: 1px;
    border: none;
    margin: 2px 4px;
}
/* modernize-tab-ui 3.1: Technology panel accents via special token */
QLabel#techAtpLabel { color: #C084FC; }
QFrame#techDivider { background: rgba(192,132,252,0.3); max-width: 1px; border: none; }
QWidget#techAncientPlaceholder {
    background: rgba(192,132,252,0.12);
    border: 1px dashed rgba(192,132,252,0.3);
    border-radius: 6px;
}
/* modernize-tab-ui 4.2: Pal Editor stat bar tiers (flat token fills). */
QSplitter#palEditorWorkspaceSplitter, QSplitter#palCollectionSplitter {
    background: transparent;
}
QSplitter#palEditorWorkspaceSplitter::handle,
QSplitter#palCollectionSplitter::handle {
    background: rgba(236,231,224,0.1);
    width: 1px;
    height: 1px;
}
QFrame#partyPanel, QFrame#palboxPanel, QFrame#palInspectorHost {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#palInspectorHost[responsiveMode="stacked"] {
    border-color: rgba(245,158,11,0.3);
}
QFrame#palInspectorIdentitySection,
QFrame#palInspectorEditableSection,
QFrame#palInspectorComputedSection,
QFrame#palInspectorTechnicalSection,
QFrame#passiveSkillsBox {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
}
QLabel#palInspectorSectionTitle {
    color: #A69F94;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 4px;
}
QLabel#palTechnicalLabel {
    color: #A69F94;
    font-size: 11px;
}
QLabel[editableValue="true"] {
    background: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
    padding: 1px 4px;
    font-weight: 600;
}
QLabel[editableValue="true"]:hover {
    border-color: rgba(245,158,11,0.5);
    background: rgba(245,158,11,0.07);
}
QLabel#palSourceLabel {
    color: #A69F94;
    font-size: 12px;
    font-weight: 600;
}
QLabel#palSourcePlayer {
    color: #ECE7E0;
    font-size: 12px;
}
QPushButton#palSourceModeChip {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 2px 8px;
}
QPushButton#palSourceModeChip[pickerSelected="true"] {
    background: rgba(245,158,11,0.1);
    color: #F59E0B;
    border-color: rgba(245,158,11,0.5);
}
QFrame#partySlot, QFrame#palboxSlot {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
}
QFrame#partySlot:hover, QFrame#palboxSlot:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QFrame#partySlot[selected="true"], QFrame#palboxSlot[selected="true"] {
    background: rgba(245,158,11,0.18);
    border: 2px solid #F59E0B;
}
QFrame#partySlot[multiSelected="true"], QFrame#palboxSlot[multiSelected="true"] {
    background: rgba(192,132,252,0.12);
    border: 1px solid #C084FC;
}
QFrame#partySlot[empty="true"], QFrame#palboxSlot[empty="true"] {
    background: #1B1917;
    border-color: rgba(236,231,224,0.1);
}
QProgressBar#palStatBar {
    background: #262220;
    border: none;
    border-radius: 2px;
    text-align: center;
    color: #ECE7E0;
    font-size: 11px;
    font-weight: 600;
}
QProgressBar#palStatBar[barTier="success"]::chunk { background: #2DD4BF; border-radius: 2px; }
QProgressBar#palStatBar[barTier="warning"]::chunk { background: #E8B44C; border-radius: 2px; }
QProgressBar#palStatBar[barTier="info"]::chunk { background: #93B7DD; border-radius: 2px; }
QProgressBar#palStatBar[barTier="special"]::chunk { background: #C084FC; border-radius: 2px; }
/* modernize-tab-ui 4.5: party HP pill — dark surface below the bar so the
   value text never overlaps the fill. */
QLabel#palHpPill {
    background: rgba(33,30,27,0.98);
    color: #ECE7E0;
    font-size: 11px;
    font-weight: 600;
    border-radius: 9999px;
    padding: 0px 8px;
}
/* Pal Editor action rows: compact global tiers plus a contextual single-row
   selection surface with less-frequent mutations in an overflow menu. */
QWidget#palboxPanel QPushButton#ghostBtn {
    padding: 2px 5px;
    font-size: 11px;
}
QWidget#palboxPanel QPushButton#warnActionBtn {
    padding: 2px 5px;
    font-size: 11px;
}
QWidget#palboxPanel QPushButton[class="danger"] {
    padding: 2px 5px;
    font-size: 11px;
}
QFrame#multiToolbar {
    background: #211E1B;
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 8px;
    padding: 2px;
}
QLabel#palMultiCount {
    color: #F59E0B;
    font-size: 11px;
    font-weight: 600;
    padding: 0 4px;
}
QFrame#multiToolbar QPushButton {
    min-height: 0px;
    padding: 2px 8px;
    font-size: 11px;
}
QFrame#bulkWorkflowReview {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#bulkWorkflowReview[riskVariant="destructive"] {
    border-color: rgba(248,113,113,0.35);
}
QLabel#bulkWorkflowField {
    color: #A69F94;
    font-size: 11px;
    font-weight: 600;
    min-width: 56px;
}
QLabel#bulkWorkflowValue {
    color: #ECE7E0;
    font-size: 12px;
}
QLabel#bulkWorkflowRisk {
    color: #F87171;
    background: rgba(248,113,113,0.12);
    border: 1px solid rgba(248,113,113,0.35);
    border-radius: 6px;
    padding: 4px 8px;
}
QLabel#bulkWorkflowBackup { color: #E8B44C; }
QLabel#bulkWorkflowResult[resultState="success"] { color: #2DD4BF; }
QLabel#bulkWorkflowResult[resultState="error"] { color: #F87171; }
QProgressBar#bulkWorkflowProgress {
    min-height: 16px;
    font-weight: 600;
}
QProgressBar#bulkWorkflowProgress[resultState="success"],
QProgressBar#bulkWorkflowProgress[resultState="error"] { color: #1C1206; }
QProgressBar#bulkWorkflowProgress[resultState="success"]::chunk { background: #2DD4BF; }
QProgressBar#bulkWorkflowProgress[resultState="error"]::chunk { background: #F87171; }
QTreeWidget#jsonTree {
    background: #141312;
    alternate-background-color: #1B1917;
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
}
/* uiux-audit-remediation 7.3 (design D12): JSON Editor path breadcrumb —
   muted separators/placeholder, clickable crumb chips with accent hover. */
QWidget#jsonBreadcrumb {
    background: transparent;
}
QLabel#jsonCrumb {
    color: #A69F94;
    background: transparent;
    border-radius: 6px;
    padding: 0 4px;
}
QLabel#jsonCrumb:hover {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
}
QLabel#jsonCrumbMuted {
    color: #5C564E;
    background: transparent;
    padding: 0 2px;
}
QPlainTextEdit#jsonRawEditor {
    font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
    background: #141312;
}
QLabel#jsonRawNotice {
    color: #E8B44C;
    background: rgba(232,180,76,0.12);
    border: 1px solid rgba(232,180,76,0.35);
    border-radius: 6px;
    padding: 8px;
}
QLabel#jsonRawValidation { color: #A69F94; }
/* Map workspace: explicit controls, structured explorer, map-first canvas,
   responsive inspector, and one consolidated navigation readout. */
QFrame#mapControlBar, QFrame#mapExplorerPanel, QFrame#mapInspectorHost {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
}
QFrame#mapCanvasFrame {
    background: #141312;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
}
QLabel#mapExplorerCount {
    color: #A69F94;
    background: transparent;
}
QFrame#mapNavigationBar {
    background: #2A2623;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
}
QLabel#mapCoordsReadout, QLabel#mapZoomReadout {
    color: #ECE7E0;
    background: transparent;
    font-size: 11px;
    padding: 2px 6px;
}
QLabel#mapCalibrationNotice, QLabel#mapCalibrationWarning {
    background: #2A2623;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}
QLabel#mapCalibrationNotice { color: #93B7DD; }
QLabel#mapCalibrationWarning { color: #E8B44C; }
/* modernize-tab-ui 6.1: map overlay toggle buttons (token-styled; the
   active toggle shows the accent state instead of the retired cyan ring).
   Wide icon variant via the `wide` dynamic property. */
QPushButton#mapToggleBtn {
    color: #ECE7E0;
    background: rgba(245,158,11,0.07);
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
    min-width: 36px;
    min-height: 28px;
}
QPushButton#mapToggleBtn:hover {
    background: rgba(245,158,11,0.12);
    border-color: rgba(236,231,224,0.18);
}
QPushButton#mapToggleBtn:checked {
    background: rgba(245,158,11,0.18);
    border: 1px solid #F59E0B;
}
QPushButton#mapToggleBtn[wide="true"] {
    min-width: 40px;
}
/* uiux-audit-remediation 8.1 (design D13): +/− zoom buttons beside the
   zoom readout — same overlay-button family, token-styled. */
QPushButton#mapZoomBtn {
    color: #ECE7E0;
    background: rgba(245,158,11,0.07);
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 6px;
    font-weight: 600;
    padding: 0px;
}
QPushButton#mapZoomBtn:hover {
    background: rgba(245,158,11,0.12);
    border-color: rgba(245,158,11,0.3);
}
QPushButton#mapZoomBtn:pressed {
    background: rgba(245,158,11,0.18);
    border-color: rgba(245,158,11,0.5);
}
QPushButton#mapZoomBtn:disabled {
    color: #5C564E;
    background: transparent;
    border-color: transparent;
}
/* uiux-audit-remediation 10.1 (D11): hard separator isolating the
   destructive bulk-delete tier in the Pal Editor toolbar. */
QFrame#toolbarTierSep {
    background: rgba(236,231,224,0.18);
    border: none;
    margin: 3px 4px;
}
/* uiux-audit-remediation 10.2 (D11): computed/read-only stat readouts are
   visually demoted from editable input chrome. */
QLabel[computedValue="true"] {
    color: #A69F94;
}
QLabel[computedValue="true"][hinted="true"] {
    color: #5C564E;
}

QLabel#saveStateChip {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 5px 10px;
    color: #5C564E;
}
QLabel#saveStateChip[state="loading"] { color: #93B7DD; border-color: rgba(147,183,221,0.3); background: rgba(147,183,221,0.1); }
QLabel#saveStateChip[state="loaded"] { color: #2DD4BF; border-color: rgba(45,212,191,0.3); background: rgba(45,212,191,0.1); }
QLabel#saveStateChip[state="dirty"] { color: #E8B44C; border-color: rgba(232,180,76,0.35); background: rgba(232,180,76,0.12); }
QLabel#saveStateChip[state="saving"] { color: #93B7DD; border-color: rgba(147,183,221,0.3); background: rgba(147,183,221,0.1); }
QLabel#saveStateChip[state="error"] { color: #F87171; border-color: rgba(248,113,113,0.35); background: rgba(248,113,113,0.12); }

/* ---- Start page v3 (modernize-tab-ui): masthead save-hub + two tool groups ---- */
QWidget#startCanvas { background: transparent; }
QFrame#opsMasthead {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    padding-bottom: 12px;
}
QLabel#opsKicker {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#opsWorldName {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 17px;
    font-weight: 600;
}
QLabel#opsWorldName[state="loaded"] { color: #2DD4BF; }
QLabel#opsStateDot {
    background: #5C564E;
    border-radius: 5px;
}
QLabel#opsStateDot[state="loaded"] { background: #2DD4BF; }
QLabel#opsStateDot[state="no_save"] { background: #5C564E; }
QPushButton#opsLoadBtn {
    background: #F59E0B;
    border: 1px solid #F59E0B;
    border-radius: 8px;
    color: #1C1206;
    font-weight: 600;
    padding: 8px 16px;
}
QPushButton#opsLoadBtn:hover { background: #F7B03A; border-color: #F7B03A; }
QPushButton#opsLoadBtn:pressed { background: #D98A06; }
QPushButton#opsLoadBtn[loadKind="secondary"] {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#opsLoadBtn[loadKind="secondary"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
}
QPushButton#opsSavePath {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 6px;
    padding: 2px 0px;
    text-align: left;
    font-size: 12px;
    font-family: 'Cascadia Mono','Consolas';
}
QPushButton#opsSavePath:hover { color: #F59E0B; }
/* uiux-audit-remediation 3.1 (design D8): segmented platform control — two
   exclusive segments rendered as one connected control; the selected
   segment takes the primary accent treatment. */
QWidget#platformSegment { background: transparent; }
QPushButton#platformSegmentBtn {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 0;
    padding: 6px 14px;
    min-height: 26px;
    font-weight: 600;
}
QPushButton#platformSegmentBtn[segmentRole="start"] {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-right: none;
}
QPushButton#platformSegmentBtn[segmentRole="end"] {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left: none;
}
QPushButton#platformSegmentBtn:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#platformSegmentBtn:checked {
    background: #F59E0B;
    color: #1C1206;
    border-color: #F59E0B;
}
QPushButton#platformSegmentBtn:checked:hover {
    background: #F7B03A;
    border-color: #F7B03A;
}
QPushButton#platformSegmentBtn:focus {
    outline: none;
    border-color: rgba(245,158,11,0.5);
}
QPushButton#platformSegmentBtn:checked:focus { border-color: #F59E0B; }
/* uiux-audit-remediation 3.3: click-to-copy affordance beside the path */
QPushButton#opsCopyPathBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}
QPushButton#opsCopyPathBtn:hover { background: rgba(245,158,11,0.07); }
/* uiux-audit-remediation 3.2 (design D9): live activity log panel —
   bounded height, console-like dark surface, muted header row. */
QWidget#activityLogPanel { background: transparent; }
QLabel#activityLogTitle {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
}
QPushButton#activityLogClearBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
}
QPushButton#activityLogClearBtn:hover { background: rgba(245,158,11,0.07); }
QTextEdit#activityLogView {
    background: #141312;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(245,158,11,0.18);
    selection-color: #ECE7E0;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}
QLabel#opsDropHint { color: #5C564E; font-size: 11px; }
QLabel#toolsFooterHint { color: #5C564E; font-size: 11px; }
QWidget#metricRow { background: transparent; }
QWidget#fieldMetric { background: transparent; border-radius: 6px; }
QWidget#fieldMetric:hover { background: rgba(245,158,11,0.07); }
QLabel#fieldMetricValue {
    color: #ECE7E0;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 15px;
    font-weight: 600;
}
QLabel#fieldMetricValue[placeholder="true"] { color: #5C564E; font-weight: 400; }
QWidget#missionColumn { background: transparent; }
QLabel#missionZone {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 0;
}
QPushButton#missionRow {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 0px;
}
QPushButton#missionRow:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
}
QPushButton#missionRow:pressed { background: rgba(245,158,11,0.12); }
QPushButton#missionRow:focus { border: 1px solid rgba(245,158,11,0.5); }
QLabel#missionRowIcon {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 6px;
}
QLabel#missionRowTitle { color: #ECE7E0; font-size: 12px; font-weight: 600; }
QLabel#missionRowDesc { color: #A69F94; font-size: 11px; }

QPushButton#dialogOption {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 8px 12px;
    color: #ECE7E0;
    text-align: left;
    padding-left: 16px;
}
QPushButton#dialogOption:hover { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.3); }
QPushButton#dialogOption:pressed { background: rgba(245,158,11,0.12); }
QPushButton#dialogCancel {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    padding: 8px 24px;
    color: #A69F94;
}
QPushButton#dialogCancel:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QFrame#valueCard {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame#gradientSeparator { background: rgba(236,231,224,0.1); max-height: 1px; border: none; }
QWidget#statsGrid { background: transparent; }
QLabel#statsField { color: #A69F94; }
QLabel#statsValue { color: #ECE7E0; }
QLabel#statsHeader { color: #A69F94; font-size: 11px; font-weight: 600; letter-spacing: 1px; }
QLabel#sectionHeader { color: #A69F94; font-size: 11px; font-weight: 600; letter-spacing: 1px; }
QFrame#glassPanel { background: #1B1917; border: 1px solid rgba(236,231,224,0.1); border-radius: 10px; }

/* ---- inspector panel (uiux-audit-remediation 4.1 / design D7) ---- */
QFrame#inspectorPanel {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QScrollArea#referenceInspector {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QListWidget#referenceResults {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
    color: #ECE7E0;
    outline: none;
}
QListWidget#referenceResults::item {
    min-height: 24px;
    padding: 0 8px;
    border-radius: 6px;
}
QListWidget#referenceResults::item:hover { background: rgba(245,158,11,0.07); }
QListWidget#referenceResults::item:selected {
    background: rgba(245,158,11,0.1);
    color: #ECE7E0;
}
QFrame#conversionSurface, QFrame#conversionPanel {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 10px;
}
QFrame#conversionPanel { background: #211E1B; }
QFrame#conversionResults { background: transparent; border: none; }
QFrame#inspectorSideColumn { background: transparent; }
QLabel#inspectorTitle {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
}
QLabel#inspectorRowLabel {
    color: #5C564E;
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: 600;
}
QLabel#inspectorRowValue {
    color: #ECE7E0;
    font-size: 14px;
}
QLabel#inspectorEmpty {
    color: #5C564E;
    font-size: 14px;
    background: transparent;
    padding: 16px;
}
QPushButton#inspectorCopyValue {
    background: transparent;
    color: #ECE7E0;
    border: none;
    border-radius: 6px;
    padding: 1px 2px;
    text-align: left;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 12px;
}
QPushButton#inspectorCopyValue:hover { background: rgba(245,158,11,0.07); color: #F59E0B; }

/* ---- ui-modernization Phase 0: promoted selectors (were inline or missing).
   Token/property selectors only. Dialogs that still carry inline copies of
   these rules keep rendering from their inline copy until their Phase 4
   migration; the builder copy is the target state. ---- */
QWidget#windowControls { background: transparent; border: none; }
QPushButton#windowControlBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #A69F94;
    padding: 0px;
}
QPushButton#windowControlBtn:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#windowControlBtn:pressed { background: rgba(245,158,11,0.12); }
QPushButton#windowControlBtn:focus { border: 1px solid rgba(245,158,11,0.3); }
QPushButton#windowControlBtn:disabled { color: #5C564E; background: transparent; }
QPushButton#windowControlBtn[danger="true"]:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}
QPushButton#navBtn {
    background: rgba(245,158,11,0.1);
    color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 600;
}
QPushButton#navBtn:hover {
    background: rgba(245,158,11,0.18);
    border-color: rgba(245,158,11,0.5);
    color: #ECE7E0;
}
QPushButton#navBtn:pressed { background: rgba(245,158,11,0.3); }
QPushButton#navBtn:focus { border: 1px solid #ECE7E0; }
QPushButton#navBtn:disabled { color: #5C564E; background: #1B1917; border-color: rgba(236,231,224,0.1); }
QFrame#passiveCard {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame[tech_selected="false"] {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame[tech_selected="false"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
}
QFrame[tech_selected="true"] {
    background: rgba(245,158,11,0.18);
    border: 1px solid rgba(245,158,11,0.5);
    border-radius: 8px;
}
/* fix-illegal cards/rows: property-driven selection (Phase 4) */
QFrame[playerCard="true"] {
    background: #1B1917;
    border: 1px solid transparent;
    border-radius: 8px;
}
QFrame[playerCard="true"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
}
QFrame[playerCard="true"][selected="true"] {
    background: rgba(245,158,11,0.18);
    border: 1px solid rgba(245,158,11,0.5);
}
QFrame[playerCard="true"][selected="true"]:hover {
    background: rgba(245,158,11,0.18);
    border-color: #F59E0B;
}
QFrame[palRow="true"] {
    background: #1B1917;
    border-radius: 8px;
}
QFrame[palRow="true"]:hover { background: rgba(245,158,11,0.07); }
QLabel#illegalPalLine { color: #ECE7E0; font-size: 11px; }
QLabel#illegalPalMarkers {
    color: #E8B44C;
    background: rgba(232,180,76,0.12);
    border: 1px solid rgba(232,180,76,0.35);
    border-radius: 6px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#illegalPlayerName {
    color: #ECE7E0;
    font-size: 14px;
    font-weight: 600;
}
QLabel#illegalPlayerDetails {
    color: #A69F94;
    font-size: 11px;
}
QScrollArea#dialogListScroll { border: none; background: transparent; }
/* transient skill-picker popup (Phase 4): floating card, global input/list rules inside */
QWidget#skillPicker {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 10px;
}
