/* GENERATED FILE — do not edit by hand.
   Global rules: src/palworld_aio/ui/chrome/qss_builder.py (edit there).
   Screen-specific rules: resources/ui/themes/legacy-dark.qss (transitional).
   Rebuild: uv run python scripts/scrs/build_theme.py */

/* ==== PalTrainer application stylesheet — generated by qss_builder. ====
   Do not edit the deployed .qss by hand; edit tokens/qss_builder and run
   scripts/scrs/build_theme.py. */

/* ---- canvas & default text ---- */
QWidget#central {
    background-color: #141312;
    color: #ECE7E0;
    font-family: 'Inter 28pt','Inter','Segoe UI';
}
QLabel {
    color: #ECE7E0;
    background: transparent;
}
QLabel[role="secondary"] { color: #A69F94; font-size: 11px; }
QLabel[role="muted"] { color: #5C564E; font-size: 11px; }
QLabel[role="accent"] { color: #F59E0B; font-size: 11px; }
QLabel[role="success"] { color: #2DD4BF; font-size: 11px; }
QLabel[role="warning"] { color: #E8B44C; font-size: 11px; }
QLabel[role="danger"] { color: #F87171; font-size: 11px; }
QLabel[role="mono"] { font-family: 'Cascadia Mono','Consolas'; }

QStackedWidget {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    color: #ECE7E0;
}
QStackedWidget > QWidget {
    background: transparent;
    color: #ECE7E0;
}
QScrollArea {
    border: none;
    background: transparent;
    border-radius: 8px;
}
/* Inner scroll containers must not fall back to the light default palette
   (Breeding results rendered as a white rectangle without this rule). */
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---- inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    padding: 5px 10px;
    selection-background-color: rgba(245,158,11,0.18);
    selection-color: #ECE7E0;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid rgba(245,158,11,0.5);
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(236,231,224,0.18);
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QLineEdit[error="true"], QSpinBox[error="true"], QDoubleSpinBox[error="true"] {
    border: 1px solid rgba(248,113,113,0.35);
    background-color: rgba(248,113,113,0.12);
}
QLineEdit[error="true"]:focus { border: 1px solid #F87171; }

QComboBox {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 18px;
}
QComboBox:hover { border-color: rgba(236,231,224,0.18); }
QComboBox:focus { border-color: rgba(245,158,11,0.5); }
QComboBox:disabled { background-color: #1B1917; color: #5C564E; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #A69F94;
    margin-right: 6px;
}
QComboBox::down-arrow:hover { border-top-color: #ECE7E0; }
QComboBox QAbstractItemView {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 5px;
    padding: 4px;
    selection-background-color: rgba(245,158,11,0.18);
    selection-color: #ECE7E0;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 10px;
    border-radius: 3px;
    min-height: 24px;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: #211E1B;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: rgba(245,158,11,0.07); }
QSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #A69F94;
}
QSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #A69F94;
}

/* ---- buttons ---- */
QPushButton {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QPushButton:pressed {
    background-color: #262220;
}
QPushButton:focus {
    border: 1px solid rgba(245,158,11,0.5);
}
QPushButton:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="primary"] {
    background-color: #F59E0B;
    color: #1C1206;
    border: 1px solid #F59E0B;
    padding: 6px 14px;
    min-height: 8px;
}
QPushButton[class="primary"]:hover {
    background-color: #F7B03A;
    border-color: #F7B03A;
}
QPushButton[class="primary"]:pressed { background-color: #D98A06; }
QPushButton[class="primary"]:focus { border: 1px solid #ECE7E0; }
QPushButton[class="primary"]:disabled {
    background-color: #211E1B;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="danger"] {
    background-color: rgba(248,113,113,0.12);
    color: #F87171;
    border: 1px solid rgba(248,113,113,0.35);
}
QPushButton[class="danger"]:hover {
    background-color: rgba(248,113,113,0.12);
    border-color: #F87171;
}
QPushButton[class="danger"]:pressed { background-color: rgba(248,113,113,0.35); }
QPushButton[class="danger"]:disabled {
    background-color: #1B1917;
    color: #5C564E;
    border-color: rgba(236,231,224,0.1);
}
QPushButton[class="ghost"] {
    background: transparent;
    color: #A69F94;
    border: 1px solid transparent;
}
QPushButton[class="ghost"]:hover {
    background-color: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[class="ghost"]:pressed { background-color: rgba(245,158,11,0.12); }
QPushButton[class="ghost"]:disabled { color: #5C564E; background: transparent; }
QPushButton[class="tool"] {
    background: transparent;
    color: #A69F94;
    border: 1px solid transparent;
    padding: 4px;
}
QPushButton[class="tool"]:hover {
    background-color: rgba(245,158,11,0.07);
    color: #ECE7E0;
    border-radius: 5px;
}
QPushButton[class="tool"]:pressed { background-color: rgba(245,158,11,0.12); }
QPushButton[class="tool"]:checked {
    background-color: rgba(245,158,11,0.12);
    color: #F59E0B;
    border-color: rgba(245,158,11,0.3);
}
QPushButton[class="tool"]:disabled { color: #5C564E; }

/* ---- selection views ---- */
QTreeWidget, QTreeView, QListWidget, QTableWidget, QTableView, QListView {
    background: transparent;
    color: #ECE7E0;
    border: 1px solid transparent;
    border-radius: 5px;
    outline: none;
    alternate-background-color: #1B1917;
}
QTreeWidget:focus, QTreeView:focus, QListWidget:focus,
QTableWidget:focus, QTableView:focus, QListView:focus {
    border: 1px solid rgba(245,158,11,0.3);
}
QTreeWidget::item, QTreeView::item, QListWidget::item,
QListView::item, QTableWidget::item, QTableView::item {
    padding: 4px 8px;
    border-radius: 3px;
    color: #ECE7E0;
}
QTreeWidget::item:hover, QTreeView::item:hover, QListWidget::item:hover,
QListView::item:hover {
    background: rgba(245,158,11,0.07);
}
QTreeWidget::item:selected, QTreeView::item:selected, QListWidget::item:selected,
QListView::item:selected {
    background: rgba(245,158,11,0.18);
    color: #ECE7E0;
}
QTreeWidget::item:selected:!active, QTreeView::item:selected:!active,
QListWidget::item:selected:!active, QListView::item:selected:!active {
    background: rgba(245,158,11,0.1);
}
QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(245,158,11,0.18);
    color: #ECE7E0;
}
QHeaderView { background: transparent; border: none; }
QHeaderView::section {
    background-color: #1B1917;
    color: #A69F94;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    border-right: 1px solid rgba(236,231,224,0.1);
    height: 28px;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section:hover { background-color: #211E1B; }
QHeaderView::section:last { border-right: none; }

/* ---- feedback & chrome ---- */
QProgressBar {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    height: 12px;
    text-align: center;
    color: #A69F94;
    font-size: 10px;
}
QProgressBar::chunk {
    background: #F59E0B;
    border-radius: 2px;
}
QCheckBox, QRadioButton {
    color: #ECE7E0;
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(236,231,224,0.18);
    background: #262220;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: rgba(245,158,11,0.3);
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #F59E0B;
    border-color: #F59E0B;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #1B1917;
    border-color: rgba(236,231,224,0.1);
}
QGroupBox {
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    margin-top: 10px;
    color: #A69F94;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #A69F94;
}

/* ---- menus, tooltips, status ---- */
QMenu {
    background-color: rgba(27,25,23,0.98);
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 5px;
    padding: 4px;
    color: #ECE7E0;
    font-size: 12px;
}
QMenu::item {
    padding: 8px 12px;
    background: transparent;
    border-radius: 3px;
    color: #ECE7E0;
}
QMenu::item:selected { background: rgba(245,158,11,0.18); color: #ECE7E0; }
QMenu::item:disabled { color: #5C564E; }
QMenu::separator {
    height: 1px;
    background: rgba(236,231,224,0.1);
    margin: 4px 0;
}
QToolTip {
    background-color: rgba(33,30,27,0.98);
    color: #ECE7E0;
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
}
QStatusBar {
    background: #1B1917;
    color: #A69F94;
    border-top: 1px solid rgba(236,231,224,0.1);
    font-size: 10px;
}
QStatusBar::item { border: none; }

/* ---- shell v3 app bar (top-nav-shell 2.1) ---- */
QFrame#appBar {
    background: #1B1917;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QPushButton#brandMark {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 2px 4px;
}
QPushButton#brandMark:hover { background: rgba(245,158,11,0.07); }
QPushButton#brandMark[pulse="true"] { background: rgba(245,158,11,0.1); }
QLabel#brandWordmark {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
QPushButton#saveStateChip {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 3px 6px;
}
QPushButton#saveStateChip:hover { border-color: rgba(245,158,11,0.3); color: #ECE7E0; }
QPushButton#saveStateChip[state="loaded"], QPushButton#saveStateChip[state="dirty"] { color: #ECE7E0; }
QPushButton#saveStateChip[state="dirty"] { border-color: rgba(232,180,76,0.35); }
QPushButton#saveStateChip[state="error"] { border-color: rgba(248,113,113,0.35); }
QPushButton#saveStateChip[pulse="true"] { border-color: #F59E0B; color: #F59E0B; }
QLabel#saveChipText {
    color: inherit;
    font-size: 10px;
    font-weight: 600;
    background: transparent;
}
QLabel#saveChipDirtyDot {
    background: #E8B44C;
    border-radius: 3px;
}
QPushButton#contextIndicator {
    background: transparent;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 1px 6px;
}
QPushButton#contextIndicator:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QLabel#contextRow {
    color: #A69F94;
    font-size: 10px;
    background: transparent;
}
QPushButton#appBarUtility {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 3px;
}
QPushButton#appBarUtility:hover { background: rgba(245,158,11,0.07); }
QPushButton#appBarUtility:checked { background: rgba(245,158,11,0.12); }
QPushButton#appBarWarnBtn {
    background: rgba(232,180,76,0.12);
    border: 1px solid rgba(232,180,76,0.35);
}
QPushButton#windowControlBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
}
QPushButton#windowControlBtn:hover { background: rgba(245,158,11,0.07); }
QPushButton#windowControlBtn[danger="true"]:hover { background: rgba(248,113,113,0.12); }

/* ---- shell v3 nav strip (top-nav-shell 3.1) ---- */
QWidget#navStrip {
    background: #1B1917;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QPushButton#navTab {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 0;
    border-bottom: 2px solid transparent;
    padding: 4px 10px 3px 10px;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 12px;
    font-weight: 600;
}
QPushButton#navTab:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#navTab:checked {
    color: #F59E0B;
    border-bottom: 2px solid #F59E0B;
}
QPushButton#navTab:focus {
    outline: none;
    color: #ECE7E0;
}
QLabel#navZoneCaption {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
    padding: 0 4px;
}
QFrame#navZoneRule {
    background: rgba(236,231,224,0.1);
}
QToolButton#navOverflowBtn {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 3px;
    padding: 2px 8px;
    font-weight: 600;
}
QToolButton#navOverflowBtn:hover { background: rgba(245,158,11,0.07); color: #F59E0B; }
QSplitter::handle:horizontal {
    background: rgba(236,231,224,0.1);
    width: 2px;
}
QSplitter::handle:horizontal:hover { background: rgba(245,158,11,0.3); width: 4px; }
QSplitter::handle:vertical {
    background: rgba(236,231,224,0.1);
    height: 2px;
}
QSplitter::handle:vertical:hover { background: rgba(245,158,11,0.3); height: 4px; }

/* ---- scrollbars ---- */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 10px;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: rgba(236,231,224,0.18);
    min-height: 24px;
    min-width: 24px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #5C564E;
}
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
    background: rgba(245,158,11,0.3);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0; width: 0; background: none; border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ---- tabs ---- */
QTabWidget::pane {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 12px;
    margin-top: -1px;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-right: 4px;
    color: #A69F94;
    font-weight: 600;
    font-size: 11px;
}
QTabBar::tab:selected {
    color: #F59E0B;
    border-bottom: 2px solid #F59E0B;
}
QTabBar::tab:hover:!selected {
    color: #ECE7E0;
    background: rgba(245,158,11,0.07);
    border-radius: 3px 3px 0 0;
}
QTabBar::close-button { image: none; subcontrol-position: right; }

/* ---- dialogs & system surfaces (022 sheet grammar) ---- */
QDialog {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.18);
}
QLabel#dialogKicker {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#dialogTitle {
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
    color: #ECE7E0;
}
QMessageBox, QInputDialog {
    background-color: #211E1B;
    color: #ECE7E0;
}
QMessageBox QLabel, QInputDialog QLabel { color: #ECE7E0; }
QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: #211E1B;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 5px 14px;
    min-width: 72px;
    font-weight: 600;
}
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
}
QFileDialog {
    background-color: #141312;
    color: #ECE7E0;
}
QFileDialog QLabel { color: #A69F94; }
QFileDialog QLineEdit {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    padding: 5px 8px;
}
QFileDialog QTreeView {
    background: #1B1917;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
}
QFileDialog QComboBox {
    background-color: #262220;
    color: #ECE7E0;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    padding: 4px 8px;
}
QListView { background: transparent; }
QColumnView { background: transparent; }
QTextBrowser { background: transparent; color: #ECE7E0; }

/* ---- shared component classes (ui/chrome/components.py sets these) ---- */
QFrame[class="panel"] {
    background-color: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame[class="card"] {
    background-color: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 8px;
}
QFrame[class="card"][selected="true"] {
    border-color: rgba(245,158,11,0.3);
    background-color: rgba(245,158,11,0.1);
}
QFrame[class="divider"] { background: rgba(236,231,224,0.1); max-height: 1px; border: none; }
QFrame[class="divider"][vertical="true"] { max-height: none; max-width: 1px; }

QLabel[class="display"] {
    font-size: 19px; font-weight: 700; color: #ECE7E0;
    letter-spacing: -0.01em;
}
QLabel[class="title"] {
    font-size: 14px; font-weight: 600; color: #ECE7E0;
}
QLabel[class="section"] {
    font-size: 12px; font-weight: 600;
    color: #ECE7E0;
}
QLabel[class="secondary"] { color: #A69F94; font-size: 11px; }
QLabel[class="micro"] { color: #A69F94; font-size: 10px; }
QLabel[class="mono"] { font-family: 'Cascadia Mono','Consolas'; }

QLabel[badge="neutral"] {
    background: #211E1B; color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="success"] {
    background: rgba(45,212,191,0.1); color: #2DD4BF;
    border: 1px solid rgba(45,212,191,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="warning"] {
    background: rgba(232,180,76,0.12); color: #E8B44C;
    border: 1px solid rgba(232,180,76,0.35); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="danger"] {
    background: rgba(248,113,113,0.12); color: #F87171;
    border: 1px solid rgba(248,113,113,0.35); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="info"] {
    background: rgba(147,183,221,0.1); color: #93B7DD;
    border: 1px solid rgba(147,183,221,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="special"] {
    background: rgba(192,132,252,0.12); color: #C084FC;
    border: 1px solid rgba(192,132,252,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}
QLabel[badge="accent"] {
    background: rgba(245,158,11,0.1); color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.3); border-radius: 9px;
    padding: 1px 8px; font-size: 10px; font-weight: 600;
}

QLabel[class="dot"][level="success"] { background: #2DD4BF; }
QLabel[class="dot"][level="warning"] { background: #E8B44C; }
QLabel[class="dot"][level="danger"] { background: #F87171; }
QLabel[class="dot"][level="info"] { background: #93B7DD; }
QLabel[class="dot"][level="special"] { background: #C084FC; }
QLabel[class="dot"][level="neutral"] { background: #5C564E; }
QLabel[class="dot"][level="accent"] { background: #F59E0B; }

QFrame[class="errorBanner"] {
    background: rgba(248,113,113,0.12);
    border: 1px solid rgba(248,113,113,0.35);
    border-radius: 5px;
}
QFrame[class="errorBanner"] QLabel { color: #F87171; }

QFrame[class="toast"][toast_level="success"] {
    background: rgba(45,212,191,0.1); border: 1px solid rgba(45,212,191,0.3); border-radius: 3px;
}
QFrame[class="toast"][toast_level="warning"] {
    background: rgba(232,180,76,0.12); border: 1px solid rgba(232,180,76,0.35); border-radius: 3px;
}
QFrame[class="toast"][toast_level="danger"] {
    background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.35); border-radius: 3px;
}
QFrame[class="toast"][toast_level="info"] {
    background: rgba(147,183,221,0.1); border: 1px solid rgba(147,183,221,0.3); border-radius: 3px;
}
QFrame[class="toast"] QLabel { font-size: 11px; font-weight: 600; }
QFrame[class="toast"][toast_level="success"] QLabel { color: #2DD4BF; }
QFrame[class="toast"][toast_level="warning"] QLabel { color: #E8B44C; }
QFrame[class="toast"][toast_level="danger"] QLabel { color: #F87171; }
QFrame[class="toast"][toast_level="info"] QLabel { color: #93B7DD; }

QFrame[class="searchField"] {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
}
QFrame[class="searchField"] QLineEdit {
    background: transparent; border: none; padding: 2px 0;
}
QFrame[class="searchField"] QLineEdit:focus { border: none; }
QFrame[class="searchField"] QLabel { color: #A69F94; }

/* ---- application shell chrome v2: NexusBand rail (plan 020) ---- */
QWidget#nexusBand {
    background-color: #141312;
    border-left: 1px solid rgba(236,231,224,0.1);
}
QWidget#bandMiddle { background: transparent; }
QFrame#bandZoneRule {
    background: rgba(236,231,224,0.1);
    border: none;
    margin: 3px 10px;
}
QLabel#bandZoneCaption {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
    padding: 4px 2px 1px 2px;
}
QPushButton[bandItem="true"] {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 3px;
    text-align: center;
    padding: 0px;
}
QPushButton[bandItem="true"]:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[bandItem="true"]:focus {
    border: 1px solid rgba(245,158,11,0.3);
}
QPushButton[bandItem="true"][active="true"] {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
    font-weight: 600;
}
QPushButton[bandItem="true"][active="true"]:hover {
    background: rgba(245,158,11,0.18);
    color: #F7B03A;
}
QPushButton[bandItem="true"]:disabled {
    color: #5C564E;
    background: transparent;
}
QPushButton[bandUtility="true"] {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 3px;
}
QPushButton[bandUtility="true"]:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[bandUtility="true"]:pressed { background: rgba(245,158,11,0.12); }
QPushButton[bandUtility="true"]:focus { border: 1px solid rgba(245,158,11,0.3); }
QPushButton[bandUtility="true"]:disabled { color: #5C564E; }
QPushButton[bandUtility="true"][active="true"] {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
}
QPushButton#bandMasthead {
    color: #A69F94;
    font-size: 15px;
}
QPushButton#bandMasthead[pulse="true"] {
    color: #E8B44C;
    background: rgba(232,180,76,0.12);
}
QLabel#bandDirtyDot {
    background: #F59E0B;
    border-radius: 4px;
}

/* ---- InstrumentTray (plan 020 §4.2) ---- */
QWidget#instrumentTray { background: transparent; }
QPushButton#trayStateRow {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    margin: 0 6px;
    text-align: left;
}
QPushButton#trayStateRow:hover { border-color: rgba(236,231,224,0.18); background: #211E1B; }
QPushButton#trayStateRow:focus { border-color: rgba(245,158,11,0.3); }
QPushButton#trayStateRow[state="loaded"] {
    background: rgba(45,212,191,0.1);
    border-color: rgba(45,212,191,0.3);
}
QPushButton#trayStateRow[state="dirty"] {
    background: rgba(232,180,76,0.12);
    border-color: rgba(232,180,76,0.35);
}
QPushButton#trayStateRow[state="error"] {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
}
QPushButton#trayStateRow[state="loading"], QPushButton#trayStateRow[state="saving"] {
    background: rgba(147,183,221,0.1);
    border-color: rgba(147,183,221,0.3);
}
QLabel#trayStateIcon {
    background: transparent; border: none;
    font-family: 'Hack Nerd Font';
    font-size: 11px;
}
QLabel#trayStateIcon[state="loaded"] { color: #2DD4BF; }
QLabel#trayStateIcon[state="dirty"] { color: #E8B44C; }
QLabel#trayStateIcon[state="error"] { color: #F87171; }
QLabel#trayStateIcon[state="loading"], QLabel#trayStateIcon[state="saving"] { color: #93B7DD; }
QLabel#trayStateText {
    background: transparent; border: none;
    color: #A69F94;
    font-size: 10px;
}
QLabel#traySection {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 3px 8px 1px 8px;
}
QLabel#trayLabel {
    color: #5C564E;
    font-size: 10px;
}
QLabel#trayValue {
    color: #ECE7E0;
    font-size: 10px;
    font-weight: 600;
}
QLabel#trayValue[placeholder="true"] { color: #5C564E; font-weight: 400; }
QLabel#trayMetricValue {
    color: #ECE7E0;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 10px;
    font-weight: 600;
}
QLabel#trayMetricValue[placeholder="true"] { color: #5C564E; font-weight: 400; }
QPushButton#trayExpandBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: #A69F94;
    font-size: 10px;
}
QPushButton#trayExpandBtn:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton#trayExpandBtn:focus { border: 1px solid rgba(245,158,11,0.3); }

/* ---- TrayDrawer overlay (canvas-local, plan 020 §4.2) ---- */
QFrame#trayDrawer {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
}
QLabel#drawerTitle {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
}
QPushButton#drawerCloseBtn {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    color: #A69F94;
    font-family: 'Hack Nerd Font';
}
QPushButton#drawerCloseBtn:hover { background: rgba(248,113,113,0.12); color: #F87171; border-color: rgba(248,113,113,0.35); }

/* ---- page ribbon (plan 020 §4.4) ---- */
QFrame#pageRibbon {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QLabel#ribbonTitle {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 19px;
    font-weight: 700;
}
QLabel#ribbonZone {
    color: #5C564E;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 600;
}
QLabel#ribbonSep {
    color: #5C564E;
    font-size: 10px;
}

/* ---- transitional: legacy sidebar/header blocks (removed in plan 025) ---- */
QWidget#sideBar {
    background-color: #141312;
    border-right: 1px solid rgba(236,231,224,0.1);
}
QLabel#sidebarSection {
    color: #5C564E;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 8px 12px 4px;
}
QPushButton[sidebarItem="true"] {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 5px;
    font-size: 14px;
    text-align: center;
    padding: 0px;
}
QPushButton[sidebarItem="true"]:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton[sidebarItem="true"]:focus {
    border: 1px solid rgba(245,158,11,0.3);
}
QPushButton[sidebarItem="true"][active="true"] {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
}
QPushButton[sidebarItem="true"][active="true"]:hover {
    background: rgba(245,158,11,0.18);
    color: #F7B03A;
}
QPushButton[sidebarItem="true"]:disabled {
    color: #5C564E;
    background: transparent;
}

/* header chips: neutral by default, semantic only where meaning exists */
QPushButton#menuChip, QLabel#versionChip, QLabel#gameVersionChip {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 4px 10px;
    color: #A69F94;
}
QPushButton#menuChip:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#menuChip:pressed { background: rgba(245,158,11,0.12); }
QPushButton#menuChip:disabled { color: #5C564E; background: #1B1917; }
QLabel#versionChip[pulse="true"] {
    background: rgba(232,180,76,0.12);
    border-color: rgba(232,180,76,0.35);
    color: #E8B44C;
}
QPushButton#controlChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #A69F94;
    text-align: center;
}
QPushButton#controlChip:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#controlChip:pressed { background: rgba(245,158,11,0.12); }
QPushButton#controlChip:disabled { color: #5C564E; }
QPushButton#controlChip[role="close"] { color: #A69F94; }
QPushButton#controlChip[role="close"]:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}

/* header action buttons: one tool-chip style; warn/save carry semantics */
QPushButton#hdrBtn, QPushButton#infoBtn, QPushButton#warnBtn, QPushButton#saveBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #A69F94;
    text-align: center;
}
QPushButton#hdrBtn:hover, QPushButton#infoBtn:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#hdrBtn:pressed, QPushButton#infoBtn:pressed { background: rgba(245,158,11,0.12); }
QPushButton#hdrBtn:disabled, QPushButton#infoBtn:disabled, QPushButton#saveBtn:disabled {
    color: #5C564E;
}
QPushButton#warnBtn {
    background: rgba(232,180,76,0.12);
    border-color: rgba(232,180,76,0.35);
    color: #E8B44C;
}
QPushButton#warnBtn:hover { background: rgba(232,180,76,0.12); border-color: #E8B44C; color: #ECE7E0; }
QPushButton#warnBtn:pressed { background: rgba(232,180,76,0.35); }
QPushButton#saveBtn {
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
}
QPushButton#saveBtn:hover { background: rgba(245,158,11,0.18); border-color: rgba(245,158,11,0.5); color: #ECE7E0; }
QPushButton#saveBtn:pressed { background: rgba(245,158,11,0.3); }
QPushButton#saveBtn[dirty="true"] {
    background: rgba(45,212,191,0.1);
    border-color: rgba(45,212,191,0.3);
    color: #2DD4BF;
}
QPushButton#saveBtn[dirty="true"]:hover { background: rgba(45,212,191,0.1); border-color: #2DD4BF; color: #ECE7E0; }
QPushButton#discordChip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #93B7DD;
}
QPushButton#discordChip:hover { background: rgba(147,183,221,0.1); border-color: rgba(147,183,221,0.3); }

/* detached console */
QFrame#mainContainer {
    background: #1B1917;
    border-radius: 8px;
    border: 1px solid rgba(236,231,224,0.1);
}
QTextEdit#consoleTextEdit {
    background: #141312;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 8px;
    selection-background-color: rgba(245,158,11,0.18);
    font-family: 'Cascadia Mono','Consolas';
}
QLabel#consoleTitleLabel {
    font-weight: bold;
    font-size: 14px;
    color: #ECE7E0;
    background: transparent;
}
QPushButton#consoleCloseBtn {
    background: transparent;
    color: #A69F94;
    font-size: 14px;
    font-weight: bold;
    border: none;
    padding: 5px;
}
QPushButton#consoleCloseBtn:hover {
    background: rgba(248,113,113,0.12);
    border-radius: 3px;
    color: #F87171;
}
QPushButton#detachButton, QPushButton#attachButton {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 4px 8px;
    color: #A69F94;
}
QPushButton#detachButton:hover, QPushButton#attachButton:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#detachButton:pressed, QPushButton#attachButton:pressed { background: rgba(245,158,11,0.12); }
QPushButton#collapseToggle {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    color: #A69F94;
}
QPushButton#collapseToggle:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#collapseToggle:pressed { background: rgba(245,158,11,0.12); }

/* results dock */
QWidget#resultsWidget { background: transparent; }
QPushButton#resultsCloseBtn {
    background: #211E1B;
    color: #A69F94;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
}
QPushButton#resultsCloseBtn:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}
QPushButton#resultsCloseBtn:pressed { background: rgba(248,113,113,0.35); }
QPushButton#copyStatsBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    color: #A69F94;
    padding: 2px;
}
QPushButton#copyStatsBtn:hover {
    background: rgba(245,158,11,0.07);
    border-radius: 3px;
    color: #ECE7E0;
}
QLabel#statsHeaderLabel { color: #ECE7E0; font-weight: 700; }
QLabel#statsFieldLabel { color: #A69F94; }
QLabel#statsValueLabel { color: #ECE7E0; font-weight: 700; }
QLabel#statsValueLabel[placeholder="true"] { color: #5C564E; font-weight: 400; }

/* ---- search screens ---- */
QLineEdit#searchInput {
    background: #262220;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 4px 10px;
    color: #ECE7E0;
    font-size: 11px;
    min-height: 28px;
}
QLineEdit#searchInput:focus { border-color: rgba(245,158,11,0.5); }
QFrame#bulkActionBar {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 8px;
}
QLabel#bulkActionLabel { font-weight: 600; color: #A69F94; }
QLabel#bulkHintLabel { color: #A69F94; font-size: 11px; }
QLabel#searchCount {
    color: #5C564E;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 10px;
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 1px 8px;
}
QFrame#tableFooter {
    background: #1B1917;
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
}
QPushButton#pageSwitchBtn {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    color: #A69F94;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#pageSwitchBtn:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QPushButton#pageSwitchBtn:checked {
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
    font-weight: 600;
}
QPushButton#pageSwitchBtn:focus { border-color: rgba(245,158,11,0.5); }
QPushButton#ghostBtn, QPushButton#toolButton {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    color: #A69F94;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#ghostBtn:hover, QPushButton#toolButton:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
    border-color: rgba(236,231,224,0.18);
}
QPushButton#ghostBtn:pressed, QPushButton#toolButton:pressed { background: rgba(245,158,11,0.12); }
QPushButton#ghostBtn:disabled, QPushButton#toolButton:disabled { color: #5C564E; }
QTreeWidget#jsonTree {
    background: #141312;
    alternate-background-color: #1B1917;
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
}
/* Map viewer: floating legend card over the canvas (008-r02) */
QWidget#mapLegendCard {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 5px;
}
QLabel#saveStateChip {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 9999px;
    padding: 5px 10px;
    color: #5C564E;
}
QLabel#saveStateChip[state="loading"] { color: #93B7DD; border-color: rgba(147,183,221,0.3); background: rgba(147,183,221,0.1); }
QLabel#saveStateChip[state="loaded"] { color: #2DD4BF; border-color: rgba(45,212,191,0.3); background: rgba(45,212,191,0.1); }
QLabel#saveStateChip[state="dirty"] { color: #E8B44C; border-color: rgba(232,180,76,0.35); background: rgba(232,180,76,0.12); }
QLabel#saveStateChip[state="saving"] { color: #93B7DD; border-color: rgba(147,183,221,0.3); background: rgba(147,183,221,0.1); }
QLabel#saveStateChip[state="error"] { color: #F87171; border-color: rgba(248,113,113,0.35); background: rgba(248,113,113,0.12); }

/* ---- Start page v2 (plan 021): masthead + field report + campaign + missions ---- */
QWidget#startCanvas { background: transparent; }
QFrame#opsMasthead {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    padding-bottom: 12px;
}
QLabel#opsKicker {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#opsWorldName {
    color: #ECE7E0;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 14px;
    font-weight: 600;
}
QLabel#opsWorldName[state="loaded"] { color: #2DD4BF; }
QLabel#opsStateDot {
    background: #5C564E;
    border-radius: 5px;
}
QLabel#opsStateDot[state="loaded"] { background: #2DD4BF; }
QLabel#opsStateDot[state="no_save"] { background: #5C564E; }
QPushButton#opsLoadBtn {
    background: #F59E0B;
    border: 1px solid #F59E0B;
    border-radius: 5px;
    color: #1C1206;
    font-weight: 700;
    padding: 8px 16px;
}
QPushButton#opsLoadBtn:hover { background: #F7B03A; border-color: #F7B03A; }
QPushButton#opsLoadBtn:pressed { background: #D98A06; }
QPushButton#opsLoadBtn[loadKind="secondary"] {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    color: #ECE7E0;
}
QPushButton#opsLoadBtn[loadKind="secondary"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
    color: #F59E0B;
}
QPushButton#opsSavePath {
    background: transparent;
    color: #A69F94;
    border: none;
    border-radius: 3px;
    padding: 2px 0px;
    text-align: left;
    font-size: 11px;
    font-family: 'Cascadia Mono','Consolas';
}
QPushButton#opsSavePath:hover { color: #F59E0B; }
QLabel#opsDropHint { color: #5C564E; font-size: 10px; }
QFrame#fieldReport {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
}
QWidget#fieldMetric { background: transparent; border-radius: 3px; }
QWidget#fieldMetric:hover { background: rgba(245,158,11,0.07); }
QLabel#fieldMetricValue {
    color: #ECE7E0;
    font-family: 'Cascadia Mono','Consolas';
    font-size: 15px;
    font-weight: 600;
}
QLabel#fieldMetricValue[placeholder="true"] { color: #5C564E; font-weight: 400; }
QFrame#campaignStrip {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(236,231,224,0.1);
    border-bottom: 1px solid rgba(236,231,224,0.1);
}
QPushButton#campaignStep {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: #A69F94;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#campaignStep:hover { background: rgba(245,158,11,0.07); color: #F59E0B; }
QPushButton#campaignStep:pressed { background: rgba(245,158,11,0.12); }
QPushButton#campaignStep:focus { border: 1px solid rgba(245,158,11,0.3); }
QWidget#missionColumn { background: transparent; }
QLabel#missionZone {
    color: #5C564E;
    font-family: 'Hanken Grotesk','Segoe UI';
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 0;
}
QPushButton#missionRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(236,231,224,0.1);
    border-radius: 3px;
    color: #ECE7E0;
    text-align: left;
    padding: 10px 12px;
    font-size: 12px;
}
QPushButton#missionRow:hover {
    background: rgba(245,158,11,0.07);
    color: #F59E0B;
}
QPushButton#missionRow:pressed { background: rgba(245,158,11,0.12); color: #D98A06; }
QPushButton#missionRow:focus { border: 1px solid rgba(245,158,11,0.3); }

QPushButton#dialogOption {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 8px 12px;
    color: #ECE7E0;
    text-align: left;
    padding-left: 16px;
}
QPushButton#dialogOption:hover { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.3); }
QPushButton#dialogOption:pressed { background: rgba(245,158,11,0.12); }
QPushButton#dialogCancel {
    background: transparent;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
    padding: 8px 24px;
    color: #A69F94;
}
QPushButton#dialogCancel:hover { background: rgba(245,158,11,0.07); color: #ECE7E0; }
QFrame#valueCard {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
}
QFrame#gradientSeparator { background: rgba(236,231,224,0.1); max-height: 1px; border: none; }
QWidget#statsGrid { background: transparent; }
QLabel#statsField { color: #A69F94; }
QLabel#statsValue { color: #ECE7E0; }
QLabel#statsHeader { color: #A69F94; font-size: 10px; font-weight: 600; letter-spacing: 1px; }
QLabel#sectionHeader { color: #A69F94; font-size: 10px; font-weight: 600; letter-spacing: 1px; }
QFrame#glassPanel { background: #1B1917; border: 1px solid rgba(236,231,224,0.1); border-radius: 8px; }

/* ---- ui-modernization Phase 0: promoted selectors (were inline or missing).
   Token/property selectors only. Dialogs that still carry inline copies of
   these rules keep rendering from their inline copy until their Phase 4
   migration; the builder copy is the target state. ---- */
QWidget#windowControls { background: transparent; border: none; }
QPushButton#windowControlBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #A69F94;
    padding: 0px;
}
QPushButton#windowControlBtn:hover {
    background: rgba(245,158,11,0.07);
    color: #ECE7E0;
}
QPushButton#windowControlBtn:pressed { background: rgba(245,158,11,0.12); }
QPushButton#windowControlBtn:focus { border: 1px solid rgba(245,158,11,0.3); }
QPushButton#windowControlBtn:disabled { color: #5C564E; background: transparent; }
QPushButton#windowControlBtn[danger="true"]:hover {
    background: rgba(248,113,113,0.12);
    border-color: rgba(248,113,113,0.35);
    color: #F87171;
}
QPushButton#navBtn {
    background: rgba(245,158,11,0.1);
    color: #F59E0B;
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 5px;
    padding: 6px 10px;
    font-weight: 600;
}
QPushButton#navBtn:hover {
    background: rgba(245,158,11,0.18);
    border-color: rgba(245,158,11,0.5);
    color: #ECE7E0;
}
QPushButton#navBtn:pressed { background: rgba(245,158,11,0.3); }
QPushButton#navBtn:focus { border: 1px solid #ECE7E0; }
QPushButton#navBtn:disabled { color: #5C564E; background: #1B1917; border-color: rgba(236,231,224,0.1); }
QFrame#passiveCard {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
}
QFrame[tech_selected="false"] {
    background: #1B1917;
    border: 1px solid rgba(236,231,224,0.1);
    border-radius: 5px;
}
QFrame[tech_selected="false"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
}
QFrame[tech_selected="true"] {
    background: rgba(245,158,11,0.18);
    border: 1px solid rgba(245,158,11,0.5);
    border-radius: 5px;
}
/* fix-illegal cards/rows: property-driven selection (Phase 4) */
QFrame[playerCard="true"] {
    background: #1B1917;
    border: 1px solid transparent;
    border-radius: 5px;
}
QFrame[playerCard="true"]:hover {
    background: rgba(245,158,11,0.07);
    border-color: rgba(245,158,11,0.3);
}
QFrame[playerCard="true"][selected="true"] {
    background: rgba(245,158,11,0.18);
    border: 1px solid rgba(245,158,11,0.5);
}
QFrame[playerCard="true"][selected="true"]:hover {
    background: rgba(245,158,11,0.18);
    border-color: #F59E0B;
}
QFrame[palRow="true"] {
    background: #1B1917;
    border-radius: 5px;
}
QFrame[palRow="true"]:hover { background: rgba(245,158,11,0.07); }
/* transient skill-picker popup (Phase 4): floating card, global input/list rules inside */
QWidget#skillPicker {
    background: #211E1B;
    border: 1px solid rgba(236,231,224,0.18);
    border-radius: 8px;
}


/* Transitional extras — RETAINED BLOCKS ONLY (plan 025 purge).
   Blocks for retired objects (old sidebar/header/results/tools cards,
   editPals legacy chrome, etc.) were removed. Remaining blocks style
   objectNames still present in code awaiting geometry-level r02 passes.
   Delete this file when the last screen migrates to the builder. */
/* Transitional extras split from darkmode.qss (UI overhaul plan 002).
   Contains objectName/property/class-specific rules only; the global
   element rules now come from the generated QSS builder. Delete this
   file when plans 004-016 finish migrating every screen. */
QWidget#central {
    background-color: #0A0C10;
}
QScrollArea#subPopupScroll,
QScrollArea#contextMenuScroll {
    background: transparent;
    border: none;
    border-radius: 0px;
}
QFrame#glass {
    background: rgba(18,20,24,0.65);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.04);
    padding: 10px;
}
QFrame#treePanel {
    background-color: transparent;
}
QTabWidget#inventoryTabs::pane {
    border: 1px solid rgba(125, 211, 252, 0.10);
    border-radius: 6px;
    background: transparent;
}
QTabWidget#inventoryTabs QTabBar::tab {
    background: rgba(255, 255, 255, 0.04);
    color: #A6B8C8;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}
QTabWidget#inventoryTabs QTabBar::tab:selected {
    background: rgba(125, 211, 252, 0.10);
    color: #7DD3FC;
}
QTabWidget#inventoryTabs QTabBar::tab:hover:!selected {
    background: rgba(125, 211, 252, 0.05);
    color: #E6EEF6;
}
QTreeWidget#baseTree,
QTreeWidget#playerTree {
    border: none;
    background: transparent;
}
QTreeWidget#baseTree::item,
QTreeWidget#playerTree::item {
    padding: 2px 4px;
}
QTreeWidget#baseTree QHeaderView::section,
QTreeWidget#playerTree QHeaderView::section {
    background: rgba(255, 255, 255, 0.05);
    color: #A6B8C8;
    padding: 4px;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    text-align: center;
}
QSplitter#collapsibleSplitter::handle:horizontal {
    background: rgba(255,255,255,0.02);
    width: 16px;
}
QFrame#hoverOverlayContainer {
    background: rgba(18,20,24,0.95);
    border: 1px solid rgba(125,211,252,0.3);
    border-radius: 8px;
}
QLabel#hoverGuildLabel {
    color: #7DD3FC;
    font-weight: bold;
}
QLabel#hoverDetailLabel {
    color: #a0aec0;
}
QLineEdit#searchInput {
    background-color: rgba(18,20,24,0.65);
    color: #dfeefc;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
QLineEdit#searchInput:focus {
    border: 1px solid rgba(125,211,252,0.5);
    background-color: rgba(18,20,24,0.85);
}
QTreeWidget#searchTree {
    background-color: rgba(18,20,24,0.65);
    color: #dfeefc;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 4px;
    alternate-background-color: rgba(255,255,255,0.02);
}
QTreeWidget#searchTree::item {
    padding: 6px 4px;
    border-bottom: 1px solid rgba(255,255,255,0.02);
    color: #dfeefc;
}
QTreeWidget#searchTree::item:selected {
    background-color: rgba(125,211,252,0.2);
    color: #7DD3FC;
}
QTreeWidget#searchTree::item:hover {
    background-color: rgba(37,150,190,0.12);
}
QTreeWidget#searchTree QHeaderView::section {
    background-color: rgba(30,33,40,0.9);
    color: #7DD3FC;
    padding: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    font-weight: bold;
}
QTreeWidget#searchTree QHeaderView::section:hover {
    background-color: rgba(37,99,235,0.25);
    color: #AEE9FF;
}
QWidget#editPalsContainer {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                stop:0 rgba(12,14,18,0.98), stop:0.5 rgba(10,16,22,0.98), stop:1 rgba(8,12,18,0.98));
    border: 1px solid rgba(125,211,252,0.2);
    border-radius: 12px;
}
QWidget#editPalsContent {
    background: transparent;
}
QFrame#palIcon {
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 40px;
    background-color: rgba(30,35,45,0.8);
}
QFrame#palIcon:hover {
    border: 2px solid #7DD3FC;
    background-color: rgba(40,45,55,0.9);
}
QFrame#palCard {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 8px;
}
QFrame#palCard:hover {
    background: rgba(125,211,252,0.08);
    border-color: rgba(125,211,252,0.2);
}
QFrame#palCard[selected="true"] {
    background: rgba(125,211,252,0.15);
    border-color: rgba(125,211,252,0.4);
}
QSpinBox#editPalsSpin::up-button,
QSpinBox#editPalsSpin::up-button:hover,
QDialog[dialogType="skillSelect"] {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                stop:0 rgba(12,14,18,0.98), stop:1 rgba(8,12,18,0.98));
    border: 1px solid rgba(125,211,252,0.2);
    border-radius: 12px;
}
