/* Transitional extras — RETAINED BLOCKS ONLY (top-nav-shell 5.2 purge).
   The legacy cyan tail (searchTree cyan selection, #dfeefc, editPalsContainer
   cyan gradient, #A6B8C8 headers, inventoryTabs cyan tabs, hover-overlay cyan)
   was removed; those surfaces now style from the builder (Deck-Ops tokens) or
   fall back to the global element rules. Remaining blocks are structural only
   (transparent containers, splitter handle). Delete this file when the last
   screen migrates to the builder. */
QScrollArea#subPopupScroll,
QScrollArea#contextMenuScroll {
    background: transparent;
    border: none;
    border-radius: 0px;
}
QTreeWidget#baseTree,
QTreeWidget#playerTree {
    border: none;
    background: transparent;
}
QTreeWidget#baseTree::item,
QTreeWidget#playerTree::item {
    padding: 2px 4px;
}
QSplitter#collapsibleSplitter::handle:horizontal {
    background: rgba(255,255,255,0.02);
    width: 16px;
}
